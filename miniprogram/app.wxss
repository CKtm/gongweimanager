page{--brand:#0f62fe;--brand-soft:#edf4ff;--ink:#121619;--muted:#4d5358;--subtle:#697077;--canvas:#f2f4f8;--line:#dde1e6;--line-strong:#c1c7cd;--radius:6rpx;--success:#198038;--warning:#805b14;--danger:#b42318;background:var(--canvas);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:28rpx;line-height:1.4}
view,scroll-view,input,textarea,button{box-sizing:border-box}
button{font-size:28rpx;font-weight:500;line-height:1.4;min-height:88rpx;padding:22rpx 26rpx;border:none;border-radius:6rpx;background:#fff;color:var(--ink)}
button::after{border:none}
button[type=primary]{background:var(--brand);border-color:var(--brand);color:#fff}
button[type=warn]{background:#fff1f1;border-color:#f1c2c2;color:var(--danger)}
button[disabled]{background:#e5e8eb!important;color:#a2a9b0!important;border-color:#dde1e6!important}
button[size=mini]{min-height:64rpx;padding:14rpx 20rpx;font-size:24rpx;line-height:1.4}
input,textarea{font-size:28rpx;color:var(--ink);line-height:1.4}
.page-intro{margin:4rpx 0 30rpx}
.page-kicker{display:block;margin-bottom:10rpx;font-size:18rpx;font-weight:500;letter-spacing:2rpx;color:var(--subtle)}
.page-title{display:block;font-size:36rpx;font-weight:700;line-height:1.2;color:var(--ink)}
.page-caption{display:block;font-size:24rpx;color:var(--muted);line-height:1.6;margin-top:12rpx}
.segmented{display:flex;gap:6rpx;padding:6rpx;margin:24rpx 0;background:#e5e8eb;border:1rpx solid var(--line);border-radius:6rpx}
.segment{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;padding:16rpx 6rpx;text-align:center;color:var(--muted);font-size:25rpx;line-height:1.3;border-radius:4rpx}
.segment.active{background:#fff;color:var(--brand);font-weight:500;box-shadow:0 1rpx 4rpx #12161908}
.section-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:32rpx 0 18rpx}
.section-label{font-size:30rpx;font-weight:500;line-height:1.3}.section-meta{font-size:23rpx;color:var(--muted)}
.quiet-link{color:var(--brand);font-size:25rpx}.eyebrow{font-size:21rpx;letter-spacing:2rpx;color:var(--muted)}
