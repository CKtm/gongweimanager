page{--brand:#176b5b;--brand-soft:#eaf4ef;--ink:#172e35;--muted:#75858a;--canvas:#f3f5f3;--line:#e7ece8;--radius:24rpx;background:var(--canvas);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:28rpx;line-height:1.6}
view,scroll-view,input,textarea,button{box-sizing:border-box}
button{font-size:28rpx;font-weight:500;line-height:1.5;min-height:88rpx;padding:22rpx 26rpx;border-radius:16rpx;background:#edf2ef;color:#35524b}button::after{border:none}button[type=primary]{background:var(--brand);color:#fff}button[type=warn]{background:#fcf0ed;color:#b55443}button[disabled]{background:#e9eeeb!important;color:#a3afaa!important}button[size=mini]{min-height:64rpx;padding:14rpx 22rpx;font-size:24rpx;line-height:1.5}input,textarea{font-size:28rpx;color:var(--ink);line-height:1.6}
.page-intro{margin:4rpx 0 28rpx}.page-kicker{display:block;font-size:20rpx;font-weight:600;letter-spacing:4rpx;color:var(--brand);margin-bottom:10rpx}.page-title{display:block;font-size:44rpx;line-height:1.25;letter-spacing:-1rpx;font-weight:600;color:var(--ink)}.page-caption{display:block;font-size:25rpx;color:var(--muted);margin-top:12rpx}.segmented{display:flex;gap:6rpx;padding:7rpx;background:#e8eeea;border-radius:17rpx;margin:24rpx 0}.segment{flex:1;text-align:center;padding:15rpx 4rpx;border-radius:12rpx;color:#73817c;font-size:25rpx}.segment.active{background:#fff;color:var(--brand);font-weight:600;box-shadow:0 2rpx 8rpx #18392c09}.section-row{display:flex;align-items:center;justify-content:space-between;margin:32rpx 0 18rpx}.section-label{font-size:30rpx;font-weight:600}.section-meta{font-size:23rpx;color:var(--muted)}.quiet-link{color:var(--brand);font-size:25rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:var(--muted)}
