<view class="nav-space {{appearance==='figma'?'figma-space':''}}"></view><view class="workspace-nav {{appearance==='figma'?'figma-nav':''}}"><view class="nav-item {{active==='home'?'active':''}}" data-key="home" bindtap="go"><image wx:if="{{appearance==='figma'}}" class="figma-nav-icon" src="{{active==='home'?'/assets/home/nav-home-active.png':'/assets/studios/nav-home.png'}}"/><view wx:else class="nav-symbol home-symbol"></view><text>工作台</text></view><view class="nav-item {{active==='spaces'?'active':''}}" data-key="spaces" bindtap="go"><image wx:if="{{appearance==='figma'}}" class="figma-nav-icon" src="{{active==='spaces'?'/assets/studios/nav-spaces.png':'/assets/home/nav-spaces.png'}}"/><view wx:else class="nav-symbol spaces-symbol"></view><text>空间</text></view><view class="nav-item {{active==='profile'?'active':''}}" data-key="profile" bindtap="go"><image wx:if="{{appearance==='figma'}}" class="figma-nav-icon" src="{{active==='profile'?'/assets/profile/nav-profile-active.png':'/assets/studios/nav-profile.png'}}"/><view wx:else class="nav-symbol profile-symbol"></view><view wx:if="{{badgeVisible}}" class="unread-badge {{badgeDragging?'badge-dragging':''}}" style="transform:translate({{badgeX}}px,{{badgeY}}px)" catchtouchstart="badgeStart" catchtouchmove="badgeMove" catchtouchend="badgeEnd" catchtouchcancel="resetBadge" catchtap="stopBadgeTap" aria-label="{{unread}}条未读消息，拖动可隐藏"><text>{{unread>99?'99+':unread}}</text></view><text>我的</text></view></view>
