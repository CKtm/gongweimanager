.nav-space{height:130rpx}.workspace-nav{position:fixed;z-index:50;left:24rpx;right:24rpx;bottom:calc(16rpx + env(safe-area-inset-bottom));display:flex;padding:18rpx 20rpx 14rpx;border:1rpx solid #e1e9e3;border-radius:26rpx;background:#fffffff5;box-shadow:0 12rpx 48rpx #16382b12}.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#8b9990;font-size:21rpx}.nav-item.active{color:#176b5b;font-weight:600}.nav-symbol{width:30rpx;height:30rpx;box-sizing:border-box;border:3rpx solid currentColor}.home-symbol{border-radius:7rpx}.spaces-symbol{border-radius:4rpx;background:linear-gradient(90deg,transparent 43%,currentColor 43%,currentColor 56%,transparent 56%),linear-gradient(transparent 43%,currentColor 43%,currentColor 56%,transparent 56%)}.profile-symbol{border-radius:50%;width:25rpx;height:25rpx;margin-bottom:5rpx;position:relative}.profile-symbol::after{content:'';position:absolute;top:22rpx;left:-7rpx;width:33rpx;height:11rpx;border:3rpx solid currentColor;border-bottom:none;border-radius:20rpx 20rpx 0 0;background:#fff}
