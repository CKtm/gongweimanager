<view class="page"><view class="page-intro"><text class="page-kicker">ACCOUNT PROFILE</text><text class="page-title">个人资料</text><text class="page-caption">维护姓名、联系方式与头像</text></view><view class="form"><button disabled="{{saving}}" bindtap="avatar"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-image" mode="aspectFill"/>更换头像</button><view class="field-label">姓名 / 昵称</view><input maxlength="30" value="{{form.nickName}}" data-field="nickName" bindinput="input"/><view class="field-label">手机号码</view><input maxlength="11" type="number" value="{{form.phonenumber}}" data-field="phonenumber" bindinput="input"/><view class="field-label">邮箱</view><input maxlength="50" value="{{form.email}}" data-field="email" bindinput="input"/><view class="field-label">性别</view><picker range="{{sexOptions}}" value="{{sexIndex}}" bindchange="sex"><view class="picker">{{sexOptions[sexIndex]}}</view></picker><button type="primary" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="save">保存资料</button></view></view>
