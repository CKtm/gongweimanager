@import "../../styles/page.wxss";
.field-label{margin:24rpx 0 12rpx;font-size:25rpx}.avatar-image{display:block;width:100rpx;height:100rpx;border-radius:50%;margin:12rpx auto}.form input{width:100%}

/* Unified native business-page appearance. */

.avatar-upload{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;width:100%;margin:0 0 28rpx;padding:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:6rpx;color:var(--brand);font-size:25rpx}.avatar-image{width:92rpx;height:92rpx;margin:0;border:1rpx solid var(--line);border-radius:50%}.form .field-label{margin-top:26rpx}.form .picker{margin-bottom:24rpx}
