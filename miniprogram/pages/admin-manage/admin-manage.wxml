<view wx:if="{{authorized}}" class="page">
 <view class="page-intro"><text class="page-kicker">ADMINISTRATION</text><text class="page-title">{{title}}</text><text class="page-caption">{{total}} 条记录 · 继承原有权限与业务校验</text></view>
 <view wx:if="{{!cap.list}}" class="notice">当前账号没有此模块查询权限。</view>
 <view wx:if="{{cap.list}}" class="search"><input placeholder="输入名称、账号、编号或关键词" value="{{search}}" bindinput="onSearch" bindconfirm="search"/><button size="mini" bindtap="search">查询</button><text bindtap="reset">重置</text></view>
 <view wx:if="{{mode!=='members' && mode!=='candidates' && mode!=='assignments'}}" class="filters"><text bindtap="advanced">高级筛选 ▾</text><picker wx:if="{{mode!=='profiles'}}" mode="selector" range="{{mode==='rooms'?['全部状态','正常','维修中','停用']:mode==='stations'?['全部状态','空闲','使用中','回收中','停用']:mode==='loginLogs'||mode==='operationLogs'?['全部状态','成功','失败']:['全部状态','正常','停用']}}" bindchange="selectStatus"><view>状态：{{filterStatus || '全部'}} ▾</view></picker><block wx:if="{{mode==='loginLogs' || mode==='operationLogs'}}"><picker mode="date" value="{{beginTime}}" data-field="beginTime" bindchange="filter"><view>{{beginTime || '开始日期'}}</view></picker><picker mode="date" value="{{endTime}}" data-field="endTime" bindchange="filter"><view>{{endTime || '结束日期'}}</view></picker></block></view>
 <view class="toolbar"><button wx:if="{{cap.add}}" size="mini" type="primary" bindtap="edit">新增</button><button wx:if="{{cap.import}}" size="mini" bindtap="import">批量导入</button><button wx:if="{{cap.export}}" size="mini" disabled="{{saving}}" bindtap="export">导出 Excel</button><button wx:if="{{cap.remove && selected.length}}" size="mini" type="warn" bindtap="remove">删除所选 {{selected.length}} 条</button><button wx:if="{{cap.remove && (mode==='loginLogs' || mode==='operationLogs')}}" size="mini" type="warn" bindtap="clean">清空日志</button><button wx:if="{{mode==='members' && cap.roleEdit}}" size="mini" type="primary" bindtap="candidates">添加用户</button><button wx:if="{{(mode==='members' || mode==='candidates') && cap.roleEdit && selected.length}}" size="mini" type="primary" bindtap="grantMembers">{{mode==='members'?'取消授权':'授权所选'}} {{selected.length}} 人</button></view>
 <view wx:if="{{loading}}" class="hint">正在加载…</view><view wx:if="{{error}}" class="notice">{{error}}</view><view wx:if="{{!list.length && !loading && cap.list}}" class="empty">暂无符合条件的记录</view>
 <view wx:for="{{list}}" wx:key="key" class="item">
  <view class="row"><view class="record-heading"><view wx:if="{{(cap.remove || mode==='members' || mode==='candidates') && !item.protected}}" data-id="{{item.key}}" bindtap="toggle"><checkbox checked="{{item.checked}}" color="#176b5b"/></view><text class="name">{{item.displayName}}</text></view><text wx:if="{{item.statusLabel}}" class="status">{{item.statusLabel}}</text></view><text class="desc">{{item.subtitle}}</text><text class="meta">ID：{{item.key}}</text>
  <view class="actions"><button size="mini" data-id="{{item.key}}" bindtap="detail">详情</button><button wx:if="{{cap.edit && !item.protected}}" size="mini" type="primary" data-id="{{item.key}}" bindtap="edit">编辑</button><block wx:if="{{mode==='users' && !item.protected}}"><button wx:if="{{cap.edit}}" size="mini" data-id="{{item.key}}" bindtap="auth">分配角色</button><button wx:if="{{cap.edit}}" size="mini" data-id="{{item.key}}" bindtap="toggleStatus">{{item.status==='0'?'停用':'恢复'}}</button><button wx:if="{{cap.reset}}" size="mini" data-id="{{item.key}}" bindtap="resetPwd">重置密码</button></block><block wx:if="{{mode==='roles' && !item.protected}}"><button wx:if="{{cap.edit}}" size="mini" data-id="{{item.key}}" bindtap="scope">数据权限</button><button wx:if="{{cap.roleEdit}}" size="mini" data-id="{{item.key}}" bindtap="members">成员授权</button><button wx:if="{{cap.edit}}" size="mini" data-id="{{item.key}}" bindtap="toggleStatus">{{item.status==='0'?'停用':'恢复'}}</button></block><block wx:if="{{mode==='profiles' && cap.edit && (item.userType==='STUDENT' || item.userType==='student')}}"><button size="mini" data-id="{{item.key}}" bindtap="relation">绑定导师</button><button wx:if="{{item.mentorId}}" size="mini" type="warn" data-id="{{item.key}}" bindtap="unbind">解绑</button></block><button wx:if="{{mode==='rooms' && item.mentorId && cap.release}}" size="mini" type="warn" data-id="{{item.key}}" bindtap="release">解除导师归属</button><button wx:if="{{mode==='loginLogs' && cap.unlock}}" size="mini" data-id="{{item.key}}" bindtap="unlock">解锁账号</button><button wx:if="{{cap.remove && !item.protected}}" size="mini" type="warn" data-id="{{item.key}}" bindtap="remove">删除</button></view>
 </view>
 <view wx:if="{{mode==='users' || mode==='roles' || mode==='loginLogs' || mode==='operationLogs' || mode==='members' || mode==='candidates'}}" class="pagination"><button size="mini" disabled="{{pageNum<=1 || loading}}" bindtap="previous">上一页</button><text>第 {{pageNum}} 页 · 共 {{total}} 条</text><button size="mini" disabled="{{pageNum*pageSize>=total || loading}}" bindtap="next">下一页</button></view>
</view>
<view wx:if="{{sheet}}" class="overlay"><view class="mask" bindtap="close" catchtouchmove="stopTouch"></view><view class="sheet"><view class="sheet-head"><text>{{sheet.title}}</text><button size="mini" class="close" disabled="{{saving}}" bindtap="close">×</button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body">
 <text wx:if="{{sheet.kind==='detail'}}" selectable class="detail">{{detail}}</text>
 <block wx:for="{{fields}}" wx:key="key" wx:for-item="f"><view class="field-label">{{f.required?'* ':''}}{{f.label}}</view><picker wx:if="{{f.type==='select'}}" disabled="{{f.disabled}}" range="{{f.options}}" range-key="label" value="{{f.index}}" data-field="{{f.key}}" bindchange="select"><view class="field {{f.disabled?'disabled':''}}">{{f.display}} ▾</view></picker><checkbox-group wx:elif="{{f.type==='multi'}}" data-field="{{f.key}}" bindchange="multi"><label wx:for="{{f.options}}" wx:key="value" wx:for-item="o" class="checkbox-line"><checkbox value="{{o.value}}" checked="{{o.checked}}" disabled="{{o.disabled}}" color="#176b5b"/><text>{{o.label}}</text></label></checkbox-group><textarea wx:elif="{{f.type==='textarea'}}" fixed class="textarea" maxlength="1000" disabled="{{f.disabled}}" value="{{form[f.key]}}" data-field="{{f.key}}" bindinput="input"/><input wx:else class="field" type="{{f.type==='number'?'number':'text'}}" password="{{f.type==='password'}}" disabled="{{f.disabled}}" value="{{form[f.key]}}" data-field="{{f.key}}" bindinput="input"/></block>
 <block wx:if="{{sheet.kind==='import'}}"><view class="notice">先下载模板，在 Excel 中填写后发到微信聊天，再从聊天文件中选择。请核对文件后导入。</view><view class="actions"><button size="mini" disabled="{{saving}}" bindtap="template">下载模板</button><button size="mini" disabled="{{saving}}" bindtap="chooseFile">选择聊天文件</button></view><text class="desc">{{importFile ? importFile.name : '尚未选择文件'}}</text><view wx:if="{{showUpdate}}" class="switch-line"><text>更新已有账号</text><switch checked="{{updateSupport}}" bindchange="updateSupport" color="#176b5b"/></view><text wx:if="{{importResult}}" selectable class="detail">{{importResult}}</text></block>
 </view></scroll-view><view wx:if="{{sheet.kind!=='detail'}}" class="sheet-footer"><button disabled="{{saving}}" bindtap="close">取消</button><button wx:if="{{sheet.kind==='import'}}" type="primary" loading="{{saving}}" disabled="{{saving || !importFile}}" bindtap="importSubmit">确认导入</button><button wx:else type="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存</button></view></view></view>
