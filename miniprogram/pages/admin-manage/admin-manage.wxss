@import "../admin/admin.wxss";
.search{display:flex;gap:14rpx;align-items:center;background:#fff;padding:16rpx;border:1rpx solid var(--line);border-radius:18rpx}.search input{flex:1;min-width:0;height:64rpx;font-size:25rpx}.search button{margin:0;flex-shrink:0}.search>text{font-size:23rpx;color:var(--muted);padding:8rpx}.filters{display:flex;gap:14rpx;flex-wrap:wrap;margin:20rpx 0;font-size:24rpx;color:var(--brand)}.filters picker{padding:10rpx 16rpx;border-radius:12rpx;background:#eaf3ec}.toolbar{display:flex;gap:14rpx;flex-wrap:wrap;margin:24rpx 0}.toolbar button{margin:0;width:auto}.record-heading{display:flex;align-items:center;gap:10rpx;min-width:0}.record-heading .name{word-break:break-all}.meta{font-size:22rpx;color:var(--muted);margin-top:12rpx;display:block}.pagination{display:flex;gap:14rpx;align-items:center;justify-content:space-between;margin:28rpx 0;font-size:23rpx;color:var(--muted)}.pagination button{margin:0;width:auto}.checkbox-line{display:flex;gap:12rpx;align-items:center;padding:16rpx 8rpx;border-bottom:1rpx solid var(--line);font-size:25rpx;line-height:1.6}.checkbox-line text{white-space:pre-wrap}.textarea{width:100%;height:170rpx;padding:20rpx;border:1rpx solid var(--line);border-radius:14rpx;background:#f5f7f4;font-size:26rpx}.detail{white-space:pre-wrap;word-break:break-all;font-size:25rpx;line-height:1.8;display:block}.switch-line{display:flex;justify-content:space-between;align-items:center;margin:24rpx 0;font-size:26rpx}.disabled{color:#9aa69e;background:#eee}
