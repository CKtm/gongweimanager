@import "../admin/admin.wxss";
.search{display:flex;gap:14rpx;align-items:center;background:#fff;padding:16rpx;border:1rpx solid var(--line);border-radius:6rpx}.search input{flex:1;min-width:0;height:64rpx;font-size:25rpx}.search button{margin:0;flex-shrink:0}.search>text{font-size:23rpx;color:var(--muted);padding:8rpx}.filters{display:flex;gap:14rpx;flex-wrap:wrap;margin:20rpx 0;font-size:24rpx;color:var(--brand)}.filters picker{padding:10rpx 16rpx;border-radius:6rpx;background:#edf4ff}.toolbar{display:flex;gap:14rpx;flex-wrap:wrap;margin:24rpx 0}.toolbar button{margin:0;width:auto}.record-heading{display:flex;align-items:center;gap:10rpx;min-width:0}.record-heading .name{word-break:break-all}.meta{font-size:22rpx;color:var(--muted);margin-top:12rpx;display:block}.pagination{display:flex;gap:14rpx;align-items:center;justify-content:space-between;margin:28rpx 0;font-size:23rpx;color:var(--muted)}.pagination button{margin:0;width:auto}.checkbox-line{display:flex;gap:12rpx;align-items:center;padding:16rpx 8rpx;border-bottom:1rpx solid var(--line);font-size:25rpx;line-height:1.6}.checkbox-line text{white-space:pre-wrap}.textarea{width:100%;height:170rpx;padding:20rpx;border:1rpx solid var(--line);border-radius:6rpx;background:#f2f4f8;font-size:26rpx}.detail{white-space:pre-wrap;word-break:break-all;font-size:25rpx;line-height:1.8;display:block}.switch-line{display:flex;justify-content:space-between;align-items:center;margin:24rpx 0;font-size:26rpx}.disabled{color:#a2a9b0;background:#eee}

/* Unified native business-page appearance. */

.search{border-radius:6rpx;padding:16rpx 20rpx;border-color:#c1c7cd}.search>text{color:#0f62fe}.filters{gap:12rpx}.filters picker{padding:12rpx 18rpx;border:1rpx solid #c6dcff;background:#edf4ff;border-radius:6rpx}.toolbar{gap:12rpx}.toolbar button{border-radius:6rpx}.checkbox-line{gap:12rpx;color:#21272a}.checkbox-line text{flex:1;min-width:0;word-break:break-all}.textarea{background:#f2f4f8;border-color:#c1c7cd;border-radius:6rpx}.disabled{color:#a2a9b0;background:#e5e8eb}.pagination{flex-wrap:wrap}.filters>text{display:flex;align-items:center}
