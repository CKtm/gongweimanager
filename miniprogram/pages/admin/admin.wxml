<view wx:if="{{authorized}}" class="page">
  <message-entry/><view class="actions"><button size="mini" data-tab="appeals" bindtap="openRecords">学生申诉 · 待终审 {{appealCount}}</button><button size="mini" data-tab="penalties" bindtap="openRecords">处罚记录</button></view>
<view class="page-intro"><text class="page-kicker">ADMIN WORKSPACE</text><text class="page-title">移动管理工作台</text><text class="page-caption">日常审批、空间配置与系统管理，一站处理</text></view>
  <view class="stats"><view><text class="stat-value">{{reviewCount}}</text><text>待审批</text></view><view><text class="stat-value">{{waitingCount}}</text><text>待分配</text></view><view><text class="stat-value">{{inspectionCount}}</text><text>待核实评分</text></view></view>
  <view class="segmented"><view class="segment {{tab==='reviews'?'active':''}}" data-tab="reviews" bindtap="switchTab">审批</view><view class="segment {{tab==='seats'?'active':''}}" data-tab="seats" bindtap="switchTab">座位</view><view class="segment {{tab==='inspections'?'active':''}}" data-tab="inspections" bindtap="switchTab">检查</view><view class="segment {{tab==='settings'?'active':''}}" data-tab="settings" bindtap="switchTab">管理</view></view>
  <view wx:if="{{error}}" class="notice">{{error}}</view><view wx:if="{{loading}}" class="loading">正在更新数据…</view>
  <view wx:if="{{tab!=='seats' && tab!=='settings'}}" class="search-box"><input placeholder="搜索学生、导师、房间或任务名称" value="{{search}}" bindinput="onSearch"/></view>
  <block wx:if="{{tab==='reviews'}}"><view class="history-toggle"><text>显示已处理与历史记录</text><switch checked="{{includeHistory}}" color="#0f62fe" bindchange="history"/></view>
    <view class="subtabs"><text class="{{reviewTab==='mobile'?'chosen':''}}" data-tab="mobile" bindtap="switchReview">流动申请</text><text class="{{reviewTab==='studio'?'chosen':''}}" data-tab="studio" bindtap="switchReview">工作室历史</text><text class="{{reviewTab==='returns'?'chosen':''}}" data-tab="returns" bindtap="switchReview">退还与回收</text></view>
    <block wx:if="{{reviewTab==='mobile'}}"><view wx:if="{{!filteredMobile.length && !loading}}" class="empty">暂无待终审或待分配的流动申请</view><view wx:for="{{filteredMobile}}" wx:key="applicationId" class="item"><view class="row"><text class="name">{{item.studentName}} · #{{item.applicationId}}</text><text class="status">{{item.statusText}}</text></view><text class="desc">{{item.reason}}</text><text class="meta">{{item.plannedStart}} 至 {{item.plannedEnd}}</text><text wx:if="{{item.mentorComment}}" class="meta">导师意见：{{item.mentorComment}}</text><view class="actions"><block wx:if="{{item.status==='PENDING_ADMIN' && perm.mobile}}"><button size="mini" type="warn" data-kind="mobile" data-id="{{item.applicationId}}" data-decision="REJECTED" bindtap="review">驳回</button><button size="mini" type="primary" data-kind="mobile" data-id="{{item.applicationId}}" data-decision="APPROVED" bindtap="review">审批通过</button></block><button wx:if="{{item.status==='WAIT_ALLOC' && perm.allocate}}" size="mini" type="primary" data-id="{{item.applicationId}}" bindtap="allocate">分配工位</button></view></view></block>
    <block wx:if="{{reviewTab==='studio'}}"><view wx:if="{{!filteredStudio.length && !loading}}" class="empty">暂无历史工作室申请记录</view><view wx:for="{{filteredStudio}}" wx:key="studioApplicationId" class="item"><view class="row"><text class="name">{{item.mentorName}}</text><text class="status">{{item.statusText}}</text></view><text class="meta">{{item.roomName}} · {{item.workstationCount || 0}} 个座位</text><text class="desc">{{item.reason}}</text></view></block>
    <block wx:if="{{reviewTab==='returns'}}"><view wx:if="{{!filteredReturns.length && !loading}}" class="empty">暂无进行中的退还与回收流程</view><view wx:for="{{filteredReturns}}" wx:key="returnId" class="item"><view class="row"><text class="name">{{item.studentName}}</text><text class="status">{{item.statusText}}</text></view><text class="meta">{{item.roomName}} / {{item.workstationNo}}</text><text class="desc">{{item.reason}}</text><view class="photos"><image wx:for="{{item.photoList}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.photoList}}" bindtap="previewPhotos"/></view><view class="actions"><block wx:if="{{item.status==='PENDING_ADMIN' && perm.returns}}"><button size="mini" type="warn" data-kind="return" data-id="{{item.returnId}}" data-decision="REJECTED" bindtap="review">{{item.sourceType?'退回补拍':'驳回'}}</button><button size="mini" type="primary" data-kind="return" data-id="{{item.returnId}}" data-decision="APPROVED" bindtap="review">{{item.sourceType?'确认释放':'同意清空'}}</button></block><block wx:if="{{item.status==='WAIT_VERIFY' && perm.verifyReturn}}"><button size="mini" type="warn" data-kind="verifyReturn" data-id="{{item.returnId}}" data-decision="REJECTED" bindtap="review">不合格</button><button size="mini" type="primary" data-kind="verifyReturn" data-id="{{item.returnId}}" data-decision="APPROVED" bindtap="review">核验释放</button></block></view></view></block>
  </block>
  <block wx:if="{{tab==='seats'}}">
    <view class="stats space-stats"><view><text class="stat-value">{{seatStats.total}}</text><text>工位总数</text></view><view><text class="stat-value">{{seatStats.available}}</text><text>空闲</text></view><view><text class="stat-value">{{seatStats.inUse}}</text><text>使用中</text></view><view><text class="stat-value">{{seatStats.pending}}</text><text>回收中</text></view></view><view class="occupancy"><text>使用率 {{seatStats.occupancy}}%</text><view class="occupancy-track"><view style="width:{{seatStats.occupancy}}%"></view></view></view>
    <view class="notice">点击空闲固定工位可分配学生；点击占用座位可调整或发起收回。流动工位从已审批申请中分配。</view>
    <scroll-view scroll-x class="rooms"><view wx:for="{{rooms}}" wx:key="roomId" class="room-chip {{selectedRoom.roomId===item.roomId?'chosen':''}}" data-id="{{item.roomId}}" bindtap="openRoom">{{item.roomName}}</view></scroll-view>
    <view wx:if="{{selectedRoom}}" class="section-row"><text class="section-label">{{selectedRoom.roomName}}</text><text class="section-meta">{{selectedRoom.mentorName || '流动工位 / 未绑定导师'}}</text></view>
    <scroll-view scroll-x><view class="seats" style="grid-template-columns:repeat({{seatGridColumns}},180rpx);width:{{seatGridColumns*194}}rpx"><view wx:for="{{roomSeats}}" wx:key="workstationId" class="seat state-{{item.status}}" style="{{item.gridPosition}}" data-id="{{item.workstationId}}" bindtap="seatAction"><text class="seat-no">{{item.workstationNo}}</text><text>{{item.studentName || '暂无使用人'}}</text><text class="seat-status">{{item.statusText}}</text></view></view></scroll-view><view wx:if="{{!roomSeats.length && !loading}}" class="empty">暂无座位，请在“管理 → 房间 / 工位配置”中维护</view>
  </block>
  <block wx:if="{{tab==='inspections'}}">
    <view class="section-row"><view class="subtabs"><text class="{{inspectionTab==='tasks'?'chosen':''}}" data-tab="tasks" bindtap="switchInspection">检查任务</text><text class="{{inspectionTab==='records'?'chosen':''}}" data-tab="records" bindtap="switchInspection">评分记录</text></view><button wx:if="{{perm.createTask}}" size="mini" type="primary" bindtap="createTask">下发任务</button></view>
    <block wx:if="{{inspectionTab==='tasks'}}"><view wx:if="{{!filteredTasks.length && !loading}}" class="empty">暂无卫生检查任务</view><view wx:for="{{filteredTasks}}" wx:key="taskId" class="item"><view class="row"><text class="name">{{item.taskName}}</text><text class="status">{{item.status==='PENDING'?'待检查':item.statusText}}</text></view><text class="meta">{{item.inspectorName}} · {{item.scheduledDate}}</text><text class="desc">{{item.remark || '检查员自行选择现场评分对象'}}</text><text class="meta">整体评分 {{(item.recordCount||0)-(item.workstationRecordCount||0)}} 条 · 工位评分 {{item.workstationRecordCount||0}} 条</text></view></block>
    <block wx:if="{{inspectionTab==='records'}}"><view wx:if="{{!filteredRecords.length && !loading}}" class="empty">暂无检查评分记录</view><view wx:for="{{filteredRecords}}" wx:key="recordId" class="item"><view class="row"><text class="name">{{item.roomName}} · {{item.workstationNo || '工作室整体'}}</text><text class="status">{{item.score == null ? item.grade+'级' : item.score+'分'}}</text></view><text class="meta">任务 #{{item.taskId}} · {{item.inspectorName}} · {{item.statusText}}</text><text class="desc">{{item.explanation}}</text><text wx:if="{{item.issueDescription}}" class="issue">问题：{{item.issueDescription}}</text><text wx:if="{{item.adminComment}}" class="meta">处理意见：{{item.adminComment}}</text><view class="photos"><image wx:for="{{item.photoList}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.photoList}}" bindtap="previewPhotos"/></view><view class="actions"><button wx:if="{{perm.verifyRecord && item.taskStatus==='SUBMITTED' && (item.status==='SUBMITTED' || item.status==='VERIFIED')}}" size="mini" type="primary" data-id="{{item.recordId}}" bindtap="recordAction">{{item.status==='SUBMITTED'?'核实评分':'归档记录'}}</button><text wx:if="{{item.taskStatus==='IN_PROGRESS' || item.taskStatus==='PENDING'}}" class="meta">检查员尚未完成任务</text></view></view></block>
  </block>
<block wx:if="{{tab==='settings'}}"><view class="notice">按权限显示管理入口；账号、角色及基础配置均可在此维护。</view><view wx:for="{{management}}" wx:key="mode" class="management-card" data-mode="{{item.mode}}" bindtap="openManagement"><view><text class="name">{{item.title}}</text><text class="meta">{{item.description}}</text></view><text class="management-arrow">›</text></view></block>
</view>
<view wx:if="{{sheet}}" class="overlay"><view class="mask" bindtap="closeSheet" catchtouchmove="stopTouch"></view><view class="sheet"><view class="sheet-head"><text>{{sheet.title}}</text><button size="mini" class="close" disabled="{{saving}}" bindtap="closeSheet">×</button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body"><view class="sheet-description">{{sheet.description}}</view>
  <block wx:if="{{sheet.kind==='seat'}}"><view class="seat-detail">使用人：{{sheet.assignment.studentName}}</view><view class="seat-detail">类型：{{sheet.seat.workstationType==='FIXED'?'固定工位':'流动工位'}}</view><view class="seat-detail">分配时间：{{sheet.assignment.startedAt}}</view><view wx:if="{{sheet.assignment.termCode}}" class="seat-detail">使用期限：{{sheet.assignment.termCode}}</view><view class="notice">主动收回后进入清理和核验流程，通过后释放工位。</view><view class="actions"><button wx:if="{{perm.adjust && sheet.seat.status==='IN_USE'}}" type="primary" size="mini" bindtap="adjust">调整工位</button><button wx:if="{{perm.recall && sheet.seat.status==='IN_USE'}}" type="warn" size="mini" bindtap="recall">发起收回</button></view></block>
  <block wx:if="{{sheet.taskForm}}"><view class="field-label">任务名称</view><input class="field" maxlength="200" placeholder="例如：秋季学期卫生检查" data-field="taskName" value="{{taskName}}" bindinput="onInput"/><view class="field-label">指定检查员</view><picker range="{{inspectors}}" range-key="nickName" value="{{inspectorIndex}}" bindchange="onInspector"><view class="field">{{inspectorIndex>=0 ? (inspectors[inspectorIndex].nickName || inspectors[inspectorIndex].userName) : '请选择检查员'}}</view></picker><view wx:if="{{!inspectors.length}}" class="hint">暂无可选检查员，或没有人员查询权限，请在“管理 → 用户账号”中检查。</view><view class="field-label">检查日期</view><picker mode="date" value="{{scheduledDate}}" data-field="scheduledDate" bindchange="onInput"><view class="field">{{scheduledDate || '请选择检查日期'}}</view></picker></block>
  <block wx:if="{{sheet.selectStudent}}"><view class="field-label">学生（限所属导师、当前无工位）</view><picker range="{{studentOptions}}" range-key="label" value="{{studentIndex}}" bindchange="onStudent"><view class="field">{{studentIndex>=0 ? studentOptions[studentIndex].label : '请选择学生'}}</view></picker><view wx:if="{{!studentOptions.length}}" class="hint">暂无可分配学生，请检查师生关系及人员查询权限。</view></block>
  <block wx:if="{{sheet.term}}"><view class="field-label">开始日期</view><picker mode="date" value="{{usageStart}}" disabled="{{saving}}" data-field="usageStart" bindchange="onInput"><view class="field">{{usageStart || '请选择开始日期'}} ▾</view></picker><view class="field-label">结束日期</view><picker mode="date" value="{{usageEnd}}" start="{{usageStart}}" disabled="{{saving}}" data-field="usageEnd" bindchange="onInput"><view class="field">{{usageEnd || '请选择结束日期'}} ▾</view></picker></block>
  <block wx:if="{{sheet.selectStation}}"><view class="field-label">{{sheet.optionalStation?'选择流动工位（可稍后分配）':'目标工位'}}</view><picker disabled="{{sheet.optionalStation && !perm.allocate}}" range="{{stationOptions}}" range-key="label" value="{{stationIndex}}" bindchange="onStation"><view class="field">{{stationIndex>=0 ? stationOptions[stationIndex].label : (sheet.optionalStation?'暂不分配工位':'请选择工位')}}</view></picker><view wx:if="{{!stationOptions.length}}" class="hint">当前没有可用目标工位。</view><text wx:if="{{sheet.optionalStation && stationIndex>=0}}" class="quiet-link" bindtap="clearStation">改为仅审批通过</text></block>
  <block wx:if="{{!sheet.noComment}}"><view class="field-label">{{sheet.taskForm?'任务说明（选填）':'处理意见 / 原因'}}</view><textarea fixed maxlength="500" class="comment-input" value="{{comment}}" data-field="comment" bindinput="onInput" placeholder="请填写具体说明"/></block>
  </view></scroll-view><view wx:if="{{sheet.kind!=='seat'}}" class="sheet-footer"><button disabled="{{saving}}" bindtap="closeSheet">取消</button><button type="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submitSheet">{{sheet.kind==='mobile' && stationIndex>=0?'审批并分配':'确认提交'}}</button></view></view></view>
