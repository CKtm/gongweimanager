@import "../../styles/page.wxss";
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.stats>view{display:flex;flex-direction:column;align-items:center;padding:22rpx 8rpx;background:#fff;border:1rpx solid var(--line);border-radius:6rpx;color:var(--muted);font-size:23rpx}.stat-value{font-size:42rpx;font-weight:600;color:var(--brand)}.loading{padding:12rpx;text-align:center;font-size:24rpx;color:var(--muted)}.search-box{padding:16rpx 22rpx;border-radius:6rpx;background:#fff;border:1rpx solid var(--line);margin-bottom:20rpx}.search-box input{height:54rpx;font-size:25rpx}.subtabs{display:flex;gap:22rpx;margin:16rpx 0 24rpx;font-size:25rpx;color:#697077}.subtabs text{padding:8rpx 0}.subtabs .chosen{color:var(--brand);font-weight:600;border-bottom:4rpx solid var(--brand)}.section-row .subtabs{margin:0}.section-row button{margin:0}.row{display:flex;justify-content:space-between}.name{font-weight:600;font-size:28rpx}.meta,.desc{display:block;margin-top:10rpx;font-size:24rpx}.actions{display:flex;margin-top:20rpx;flex-wrap:wrap}.photos{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.photos image{width:144rpx;height:144rpx}.issue{display:block;color:#b42318;font-size:25rpx;margin-top:12rpx}.rooms{white-space:nowrap;margin:24rpx 0}.room-chip{display:inline-block;padding:14rpx 26rpx;border-radius:6rpx;background:#fff;border:1rpx solid var(--line);margin-right:14rpx}.room-chip.chosen{background:var(--brand-soft);border-color:#a6c8ff;color:var(--brand)}.seats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.seat{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:22rpx 8rpx;border:1rpx solid #dde1e6;background:#fff;border-radius:6rpx;font-size:24rpx;text-align:center;word-break:break-all}.seat-no{font-weight:600;font-size:30rpx}.seat-status{font-size:21rpx;color:var(--muted)}.state-AVAILABLE{background:#edf4ff}.state-IN_USE{border-color:#a6c8ff}.state-PENDING_RETURN{background:#fcf5e8;border-color:#e9dab9}.state-DISABLED{background:#f2f4f8;color:#a2a9b0}.overlay{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end}.mask{position:absolute;inset:0;background:#10282066}.sheet{position:relative;width:100%;max-height:88vh;display:flex;flex-direction:column;background:#fff;border-radius:28rpx 28rpx 0 0;padding-bottom:env(safe-area-inset-bottom)}.sheet-head{display:flex;justify-content:space-between;align-items:center;padding:24rpx 30rpx;font-size:32rpx;font-weight:600}.sheet-head .close{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;min-height:64rpx;margin:0;padding:0;border-radius:50%;font-size:38rpx;line-height:1}.sheet-scroll{height:55vh;min-height:0}.sheet-body{padding:0 30rpx 28rpx}.sheet-description{padding:18rpx 22rpx;background:var(--brand-soft);border-radius:6rpx;color:#002d9c;font-size:25rpx;margin-bottom:24rpx;line-height:1.7}.field-label{font-size:25rpx;margin:20rpx 0 12rpx;font-weight:500}.field{width:100%;min-height:88rpx;border:1rpx solid var(--line);border-radius:6rpx;background:#f2f4f8;font-size:26rpx;padding:20rpx;line-height:1.7}.sheet-body input.field{height:88rpx;padding:0 20rpx;line-height:88rpx}.comment-input{width:100%;height:160rpx;border:1rpx solid var(--line);border-radius:6rpx;padding:20rpx;background:#f2f4f8;font-size:26rpx}.sheet-footer{display:flex;gap:18rpx;border-top:1rpx solid var(--line);padding:22rpx 30rpx}.sheet-footer button{margin:0;flex:1}.sheet-footer button[type=primary]{flex:2}.hint{font-size:23rpx;margin-top:12rpx}.seat-detail{margin:16rpx 0;font-size:26rpx}
.actions button{width:auto;flex:0 0 auto}.sheet-footer button{min-width:0}.search-box input{border:none;background:transparent;padding:0}
.history-toggle{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;color:var(--muted);margin:12rpx 0 18rpx}.management-card{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:28rpx;background:#fff;border:1rpx solid var(--line);border-radius:6rpx;margin:18rpx 0}.management-card>view{flex:1}.management-arrow{font-size:42rpx;color:#697077}
.space-stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:20rpx}.space-stats .stat-value{font-size:36rpx}.occupancy{margin:18rpx 0 28rpx;color:var(--muted);font-size:23rpx}.occupancy-track{height:12rpx;background:#dde1e6;border-radius:6rpx;overflow:hidden;margin-top:12rpx}.occupancy-track>view{height:100%;background:var(--brand);border-radius:6rpx}

/* Unified native business-page appearance. */

.stats{gap:12rpx}.stats>view{padding:24rpx 8rpx;border-radius:6rpx}.stat-value{font-size:38rpx;font-weight:700}.subtabs{gap:24rpx;color:var(--muted);flex-wrap:wrap}.subtabs .chosen{font-weight:500}.rooms .room-chip{border-radius:6rpx}.room-chip.chosen{border-color:#0f62fe;background:#edf4ff;color:#0f62fe}.seat{border-radius:6rpx;border-color:#dde1e6}.state-AVAILABLE{background:#edf4ff;border-color:#a6c8ff}.state-IN_USE{background:#fff;border-color:#c1c7cd}.state-PENDING_RETURN{background:#fff8e1;border-color:#dfbd58}.state-DISABLED{background:#f2f4f8;color:#a2a9b0}.sheet{border-radius:12rpx 12rpx 0 0}.sheet-head .close{flex:0 0 64rpx;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;min-height:64rpx;max-height:64rpx;padding:0;line-height:1;border:none;border-radius:50%;background:#f2f4f8;color:#697077}.sheet-description{background:#edf4ff;color:#002d9c;border:1rpx solid #c6dcff}.field,.comment-input{background:#f2f4f8;border-color:#c1c7cd;border-radius:6rpx}.sheet-body input.field{height:92rpx;min-height:92rpx;line-height:92rpx;padding:0 22rpx}.management-card{border-radius:6rpx}.management-arrow{color:#697077}.occupancy-track{background:#dde1e6}
