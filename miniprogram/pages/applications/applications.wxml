<view class="page">
  <view class="page-intro"><text class="page-kicker">WORKSPACE APPLICATION</text><text class="page-title">流动工位申请</text><text class="page-caption">导师初审 · 管理员终审 · 统一分配</text></view><view class="flow-strip"><text class="flow-step">01 提交申请</text><text>›</text><text class="flow-step">02 导师初审</text><text>›</text><text class="flow-step">03 管理员终审</text></view><view class="eligibility {{eligible ? 'allowed' : 'blocked'}}">{{eligibilityText}}</view><view class="form"><view class="section-title">提交流动工位申请</view><textarea placeholder="请填写申请原因" value="{{reason}}" bindinput="onInput" /><view class="dates"><picker mode="date" value="{{start}}" data-field="start" bindchange="onDate"><view>{{start || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{end}}" start="{{start}}" data-field="end" bindchange="onDate"><view>{{end || '结束日期'}}</view></picker></view><button type="primary" loading="{{submitting}}" disabled="{{submitting || !eligible}}" bindtap="submit">提交申请</button></view><view class="section-title history-title">申请记录</view><view wx:if="{{!list.length}}" class="empty">暂无申请记录</view><view wx:for="{{list}}" wx:key="applicationId" class="item"><view class="content"><view class="row"><text class="name">申请 #{{item.applicationId}}</text><text class="status">{{item.statusText}}</text></view><text class="desc">{{item.reason}}</text><text class="meta">期限：{{item.plannedStart}} 至 {{item.plannedEnd}}</text><text wx:if="{{item.mentorComment}}" class="comment">导师意见：{{item.mentorComment}}</text><text wx:if="{{item.adminComment}}" class="comment">管理员意见：{{item.adminComment}}</text><text wx:if="{{item.workstationNo}}" class="result">已分配工位：{{item.workstationNo}}</text></view></view></view>
