.page { min-height: 100vh; padding: 30rpx; background:#f5f7fb; }.eligibility{padding:22rpx;margin-bottom:20rpx;border-radius:6rpx;font-size:24rpx}.eligibility.allowed{background:#f0f9eb;color:#0f62fe}.eligibility.blocked{background:#fff7e6;color:#d46b08}.form { padding:30rpx;background:#fff;border-radius:6rpx; }.section-title { font-size:32rpx;font-weight:600;margin-bottom:24rpx; }.form textarea { width:100%;height:180rpx;padding:20rpx;box-sizing:border-box;background:#f7f8fa;border-radius:6rpx; }.dates { display:flex;align-items:center;justify-content:space-between;margin:25rpx 0;color:#4e5969; }.dates picker { padding:20rpx;background:#f7f8fa;border-radius:6rpx;width:40%;text-align:center; }.history-title { margin:40rpx 0 20rpx; }.item { display:flex;justify-content:space-between;padding:25rpx;margin-bottom:16rpx;background:#fff;border-radius:6rpx; }.name,.desc { display:block; }.desc { max-width:480rpx;margin-top:10rpx;color:#86909c;font-size:24rpx; }.status { color:#0f62fe;font-size:24rpx; }
.empty{padding:40rpx;text-align:center;color:#909399}.content{width:100%}.row{display:flex;justify-content:space-between;align-items:center}.meta,.comment,.result{display:block;margin-top:10rpx;font-size:24rpx;color:#606266}.result{color:#0f62fe;font-weight:600}
@import "../../styles/page.wxss";
.flow-strip{display:flex;align-items:center;justify-content:space-between;gap:6rpx;margin-bottom:26rpx;color:#a2a9b0;font-size:22rpx}.flow-step{color:#0f62fe;font-size:21rpx}.item .name{font-size:28rpx;font-weight:600}.meta,.comment{font-size:23rpx}.form textarea{margin-bottom:4rpx}.history-title{font-size:30rpx}.item .desc{max-width:none}

/* Unified native business-page appearance. */

.flow-strip{padding:18rpx 16rpx;background:var(--brand-soft);border:1rpx solid #c6dcff;border-radius:6rpx;color:#697077}.flow-step{color:#002d9c}.form textarea{height:180rpx;border:1rpx solid var(--line-strong);background:#f2f4f8;border-radius:6rpx}.dates{display:flex;align-items:center;gap:12rpx}.dates picker{width:auto;flex:1;min-width:0;padding:22rpx 10rpx;border-radius:6rpx}.row{align-items:flex-start}.item .status{font-size:21rpx;white-space:nowrap}.history-title{font-size:30rpx;font-weight:500}
