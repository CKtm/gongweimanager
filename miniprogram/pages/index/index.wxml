<view class="page dashboard">
  <view class="dashboard-top"><view><text class="eyebrow">CAMPUS WORKSPACE</text><text class="greeting">你好，{{userInfo.nickName || userInfo.userName || '同学'}}</text></view><view class="user-chip" bindtap="openProfile">{{roleText}}</view></view>
  <view class="welcome-panel"><view class="welcome-copy"><text class="welcome-kicker">专注研究 · 有序协作</text><text class="welcome-title">让每一处空间
发挥更多价值</text><text class="welcome-caption">工位与团队，一站管理。</text></view><view class="space-art"><view class="art-table"></view><view class="art-seat a"></view><view class="art-seat b"></view><view class="art-seat c"></view><view class="art-seat d"></view><view class="art-leaf"></view></view></view>
  <view wx:if="{{isStudent}}" class="focus-card" bindtap="openMyWorkstation"><view class="focus-top"><text class="focus-label">我的专属工位</text><text class="focus-pill">{{workstation ? (workstation.workstationType === 'FIXED' ? '固定工位' : '流动工位') : '暂未分配'}}</text></view><text class="focus-title">{{workstation ? workstation.roomName + ' · ' + workstation.workstationNo : '开启你的研究空间'}}</text><view class="focus-bottom"><text>{{workstation ? '查看工位信息与使用情况' : '浏览空间，查看申请资格'}}</text><text>↗</text></view></view>
  <view wx:if="{{isMentor}}" class="focus-card" data-tab="review" bindtap="openMentorReview"><view class="focus-top"><text class="focus-label">团队协作</text><text class="focus-pill">导师工作台</text></view><text class="focus-title">{{mentorApplicationCount + mentorReturnCount}} 项待审批</text><view class="focus-bottom"><text>流动申请 {{mentorApplicationCount}} · 退还确认 {{mentorReturnCount}}</text><text>↗</text></view></view>
  <view wx:if="{{isInspector}}" class="focus-card" bindtap="openInspection"><view class="focus-top"><text class="focus-label">检查计划</text><text class="focus-pill">卫生检查员</text></view><text class="focus-title">{{inspectionTaskCount}} 项待执行</text><view class="focus-bottom"><text>进入座位图，选择对象并完成评分</text><text>↗</text></view></view>
  <view wx:if="{{isAdmin}}" class="focus-card" data-tab="reviews" bindtap="openAdmin"><view class="focus-top"><text class="focus-label">移动管理</text><text class="focus-pill">管理员工作台</text></view><text class="focus-title">{{adminPending || 0}} 项待审批</text><view class="focus-bottom"><text>待分配 {{adminWaiting || 0}} · 待核实评分 {{adminInspection || 0}}</text><text>↗</text></view></view>
  <view class="section-row"><text class="section-label">快捷服务</text><text class="section-meta">为你的角色定制</text></view>
  <view class="service-grid">
    <view class="service" bindtap="openWorkstations"><view class="service-icon icon-space">▦</view><text class="service-name">空间总览</text><text class="service-desc">房间与工位实时状态</text></view>
    <view wx:if="{{isAdmin}}" class="service" data-tab="reviews" bindtap="openAdmin"><view class="service-icon">✓</view><text class="service-name">审批中心</text><text class="service-desc">流动、工作室、退还审批</text></view>
    <view wx:if="{{isAdmin}}" class="service" data-tab="seats" bindtap="openAdmin"><view class="service-icon">▦</view><text class="service-name">座位管理</text><text class="service-desc">分配、调整与主动收回</text></view>
    <view wx:if="{{isAdmin}}" class="service" data-tab="inspections" bindtap="openAdmin"><view class="service-icon warm">◎</view><text class="service-name">卫生检查管理</text><text class="service-desc">下发任务、核实与归档</text></view>
    <view wx:if="{{isStudent}}" class="service" bindtap="openApplications"><view class="service-icon">↗</view><text class="service-name">流动工位申请 <text wx:if="{{applicationCount}}" class="badge">{{applicationCount}}</text></text><text class="service-desc">申请资格与审批进度</text></view>
    <view wx:if="{{isStudent}}" class="service" bindtap="openReturns"><view class="service-icon warm">↩</view><text class="service-name">退还与回收</text><text class="service-desc">清理上传与进度跟踪</text></view>
    <view wx:if="{{isMentor}}" class="service" bindtap="openQuota"><view class="service-icon">▤</view><text class="service-name">工作室申请</text><text class="service-desc">申请空间，查看归属</text></view>
    <view wx:if="{{isMentor}}" class="service" bindtap="openMentorReview"><view class="service-icon warm">✓</view><text class="service-name">团队管理</text><text class="service-desc">学生、工位与审批</text></view>
    <view wx:if="{{isInspector}}" class="service" bindtap="openInspection"><view class="service-icon">✓</view><text class="service-name">现场检查</text><text class="service-desc">座位评分与检查记录</text></view>
    <view class="service" bindtap="openProfile"><view class="service-icon neutral">◎</view><text class="service-name">个人中心</text><text class="service-desc">身份信息与账号安全</text></view>
  </view>
  <view class="dashboard-note"><view class="note-dot"></view><text>研究生工位管理 · 让协作更有序</text></view>
  <workspace-nav active="home"/>
</view>
