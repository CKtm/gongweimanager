<view class="home-page">
  <view class="greeting-row">
    <view class="avatar-button" bindtap="openProfile" aria-role="button" aria-label="查看个人资料">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"/>
      <text wx:else class="avatar-initial">{{avatarInitial}}</text>
    </view>
    <view class="greeting-copy"><text class="greeting-label">{{greeting}} · {{roleText}}</text><text class="greeting-name">{{userInfo.nickName || userInfo.userName || '同学'}}</text></view>
    <button class="notification-button" bindtap="openNotifications" aria-label="查看当前待办事项"><image src="/assets/home/notification.png" class="notification-icon"/><text wx:if="{{!loading && pendingCount}}" class="notification-badge">{{pendingCount > 99 ? '99+' : pendingCount}}</text></button>
  </view>

  <view class="search-field"><image src="/assets/home/search.png" class="search-icon"/><input placeholder="搜索服务与业务入口" value="{{search}}" bindinput="onSearch" confirm-type="search" maxlength="80"/><button wx:if="{{search}}" class="clear-button" bindtap="clearSearch" aria-label="清空搜索"><image src="/assets/studios/close.png" class="close-icon"/></button></view>

  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="categories"><view wx:for="{{categories}}" wx:key="key" class="category-chip {{activeCategory === item.key ? 'selected-chip' : ''}}" data-key="{{item.key}}" bindtap="onCategory" aria-role="button" aria-label="{{item.label}}服务">{{item.label}}</view></view></scroll-view>

  <view class="section-heading"><text>常用服务</text><button class="see-all" bindtap="openAllServices">查看全部<image src="/assets/home/arrow.png" class="arrow-icon"/></button></view>
  <scroll-view wx:if="{{visibleServices.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="service-scroll"><view class="service-track"><view wx:for="{{visibleServices}}" wx:key="key" class="service-card" data-key="{{item.key}}" bindtap="openService" aria-role="button" aria-label="{{item.title}}">
    <view class="service-image"><image src="/assets/home/placeholder.png" class="placeholder-icon"/></view>
    <view class="service-copy"><text class="service-title">{{item.title}}</text><text class="service-description">{{item.description}}</text></view>
    <text class="service-tag">{{item.categoryLabel}}</text>
  </view></view></scroll-view>
  <view wx:else class="empty-services"><text>没有找到相关服务</text><button class="see-all" bindtap="resetServiceFilters">查看全部服务</button></view>

  <view class="section-heading next-heading"><text>当前事项</text><text wx:if="{{loading}}" class="updating">更新中…</text></view>
  <view wx:if="{{error}}" class="load-error"><text>{{error}}</text><button class="retry-button" disabled="{{loading}}" bindtap="refreshDashboard">重试</button></view>
  <view wx:for="{{nextCards}}" wx:key="key" class="next-card">
    <view class="next-leading"><image src="/assets/home/calendar.png" class="calendar-icon"/></view>
    <view class="next-copy"><text class="next-title">{{item.title}}</text><text class="next-description">{{loading ? '正在更新信息…' : item.description}}</text></view>
    <button class="view-button" data-key="{{item.key}}" bindtap="openNextCard">{{item.buttonText}}</button>
  </view>
  <workspace-nav active="home" appearance="figma"/>
</view>

<view wx:if="{{allServicesOpen || notificationsOpen}}" class="home-overlay">
  <view class="home-mask" bindtap="closeSheet" catchtouchmove="stopTouch"></view>
  <view class="home-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-heading"><text>{{notificationsOpen ? '当前待办' : '全部服务'}}</text><button class="clear-button" bindtap="closeSheet" aria-label="关闭"><image src="/assets/studios/close.png" class="close-icon"/></button></view>
    <scroll-view scroll-y class="sheet-body"><view class="sheet-content">
      <block wx:if="{{notificationsOpen}}">
        <view wx:if="{{loading}}" class="sheet-empty">正在更新待办…</view>
        <view wx:elif="{{!pendingItems.length}}" class="sheet-empty">{{error ? '待办信息暂未更新，请下拉刷新后重试' : '暂无待办事项'}}</view>
        <view wx:for="{{pendingItems}}" wx:key="key" class="sheet-row" data-key="{{item.key}}" bindtap="openPendingItem"><view><text class="sheet-row-title">{{item.title}}</text><text class="sheet-row-description">{{item.description}}</text></view><image src="/assets/home/arrow.png" class="arrow-icon"/></view>
      </block>
      <block wx:else>
        <view wx:if="{{!visibleServices.length}}" class="sheet-empty">当前筛选条件下暂无服务</view>
        <view wx:for="{{visibleServices}}" wx:key="key" class="sheet-row" data-key="{{item.key}}" bindtap="openService"><view><text class="sheet-row-title">{{item.title}}</text><text class="sheet-row-description">{{item.description}}</text></view><image src="/assets/home/arrow.png" class="arrow-icon"/></view>
      </block>
    </view></scroll-view>
  </view>
</view>
