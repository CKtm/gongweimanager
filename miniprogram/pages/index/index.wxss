@import "../../styles/page.wxss";
.dashboard-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:12rpx 0 30rpx}.greeting{display:block;font-size:38rpx;font-weight:600;line-height:1.4;margin-top:8rpx}.user-chip{font-size:21rpx;padding:10rpx 16rpx;border-radius:30rpx;background:#e4eee6;color:#3b6c55;max-width:220rpx;flex-shrink:0}.welcome-panel{position:relative;overflow:hidden;min-height:306rpx;padding:34rpx;border-radius:28rpx;background:#e5ede3}.welcome-copy{position:relative;z-index:2}.welcome-kicker{display:block;font-size:21rpx;color:#607d69;letter-spacing:3rpx}.welcome-title{display:block;white-space:pre-line;font-size:43rpx;line-height:1.4;margin:16rpx 0;color:#234b3c;font-weight:600;letter-spacing:1rpx}.welcome-caption{display:block;font-size:22rpx;color:#678471;max-width:340rpx}.space-art{position:absolute;right:22rpx;top:66rpx;width:210rpx;height:190rpx;transform:rotate(-12deg);opacity:.75}.art-table{position:absolute;left:57rpx;top:18rpx;width:108rpx;height:150rpx;background:#b4c7ae;border:8rpx solid #d4dfcd;border-radius:20rpx;box-shadow:12rpx 18rpx 0 #c6d3bd}.art-seat{position:absolute;width:36rpx;height:42rpx;background:#5c8063;border:6rpx solid #98b496;border-radius:10rpx}.art-seat.a{left:5rpx;top:30rpx}.art-seat.b{left:5rpx;top:104rpx}.art-seat.c{right:0;top:30rpx}.art-seat.d{right:0;top:104rpx}.art-leaf{position:absolute;right:25rpx;top:-24rpx;width:42rpx;height:42rpx;border-radius:50% 0 50% 50%;background:#779b6e}.focus-card{background:#183e34;color:#fff;border-radius:24rpx;padding:30rpx;margin-top:22rpx}.focus-top,.focus-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.focus-label{font-size:24rpx;color:#bdd2c6}.focus-pill{padding:5rpx 14rpx;background:#ffffff13;border:1rpx solid #ffffff20;border-radius:30rpx;font-size:21rpx;color:#d4e5d9}.focus-title{display:block;margin:20rpx 0 24rpx;font-size:38rpx;font-weight:600;letter-spacing:1rpx}.focus-bottom{border-top:1rpx solid #ffffff18;padding-top:20rpx;color:#b0cbbd;font-size:23rpx}.focus-bottom text:last-child{font-size:32rpx}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.service{padding:28rpx 24rpx;background:#fff;border:1rpx solid var(--line);border-radius:22rpx;min-height:204rpx}.service-icon{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;border-radius:17rpx;background:#eaf4ef;color:#247559;font-size:38rpx;margin-bottom:20rpx}.service-icon.warm{color:#9c7b40;background:#f7f0e0}.service-icon.neutral{color:#647d89;background:#edf2f5}.service-name{display:block;font-size:28rpx;font-weight:600;line-height:1.5}.service-desc{display:block;font-size:22rpx;color:#8b9890;margin-top:8rpx}.badge{display:inline-block;background:#b65743;color:#fff;padding:0 9rpx;border-radius:20rpx;font-size:19rpx;vertical-align:middle}.dashboard-note{display:flex;gap:12rpx;align-items:center;justify-content:center;font-size:21rpx;color:#8c9a91;margin:36rpx 0 0}.note-dot{width:8rpx;height:8rpx;border-radius:50%;background:#8da895}
