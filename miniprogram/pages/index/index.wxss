page{--brand:#0f62fe;--canvas:#f2f4f8;--ink:#121619;--muted:#4d5358;background:#f2f4f8;color:#121619;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;line-height:1.4}
.home-page{min-height:100vh;padding:30rpx 30rpx 0;background:#f2f4f8;overflow-x:hidden}
.greeting-row{display:flex;align-items:center;gap:22rpx;min-height:76rpx;margin-bottom:38rpx}
.avatar-button,.avatar-image{width:76rpx;height:76rpx;border-radius:50%;flex-shrink:0}
.avatar-button{display:flex;align-items:center;justify-content:center;overflow:hidden;background:#dde1e6}
.avatar-initial{font-size:34rpx;font-weight:500;color:#4d5358}.avatar-image{display:block}
.greeting-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:4rpx}
.greeting-label{font-size:25rpx;color:#4d5358;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.greeting-name{font-size:30rpx;font-weight:500;line-height:1.1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.notification-button{position:relative;width:76rpx;height:76rpx;min-height:76rpx;padding:18rpx;margin:0;display:flex;align-items:center;justify-content:center;border-radius:0;background:transparent;flex-shrink:0}
.notification-icon{width:38rpx;height:38rpx}.notification-badge{position:absolute;top:0;right:0;min-width:28rpx;height:28rpx;display:flex;align-items:center;justify-content:center;padding:0 6rpx;border-radius:18rpx;background:#0f62fe;color:#fff;font-size:18rpx;line-height:1}
.search-field{display:flex;align-items:center;gap:16rpx;height:92rpx;padding:0 30rpx;border:1rpx solid #c1c7cd;background:#fff;margin-bottom:38rpx}
.search-icon{width:46rpx;height:46rpx;flex-shrink:0}.search-field input{flex:1;min-width:0;height:78rpx;font-size:28rpx;line-height:1.4}
.clear-button{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;min-height:64rpx;margin:0;padding:13rpx;background:transparent;border-radius:0;flex-shrink:0}.close-icon{width:38rpx;height:38rpx}
.category-scroll{width:calc(100% + 30rpx);margin-bottom:38rpx}.categories{display:flex;gap:16rpx;width:max-content;padding-right:30rpx}
.category-chip{height:62rpx;min-width:85rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0 23rpx;border:1rpx solid #c1c7cd;border-radius:100rpx;background:#fff;font-size:28rpx;line-height:1.4;white-space:nowrap;color:#21272a}
.category-chip.selected-chip{background:#d0e2ff;color:#002d9c;border-color:#0f62fe}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:38rpx;min-height:34rpx;color:#121619;font-size:30rpx;font-weight:500;line-height:1.1}
.see-all{display:flex;align-items:center;justify-content:center;gap:8rpx;margin:0;padding:0;min-height:44rpx;width:auto;background:transparent;color:#0f62fe;font-size:25rpx;line-height:1.4;font-weight:400;border-radius:0;flex-shrink:0}.arrow-icon{width:30rpx;height:30rpx;flex-shrink:0}
.service-scroll{width:calc(100% + 30rpx);margin-bottom:38rpx}.service-track{display:flex;align-items:stretch;gap:23rpx;width:max-content;padding-right:30rpx}
.service-card{display:flex;flex-direction:column;align-items:flex-start;gap:23rpx;width:443rpx;min-height:473rpx;flex-shrink:0;padding:46rpx;border:1rpx solid #dde1e6;background:#fff;border-radius:0}
.service-image{height:214rpx;width:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#dde1e6}.service-cover{display:block;width:100%;height:100%}
.service-copy{display:flex;flex-direction:column;gap:8rpx;width:100%;min-width:0}.service-title{font-size:30rpx;font-weight:500;line-height:1.1;color:#121619;word-break:break-all}.service-description{font-size:25rpx;line-height:1.4;color:#4d5358;min-height:35rpx}
.service-tag{display:inline-flex;align-items:center;min-height:38rpx;padding:2rpx 15rpx;border-radius:100rpx;background:#dde1e6;color:#21272a;font-size:22rpx;line-height:1.4;margin-top:auto}
.next-heading{margin-top:0}.updating{font-size:22rpx;font-weight:400;color:#697077;line-height:1.4}
.next-card{display:flex;align-items:center;gap:23rpx;width:100%;padding:46rpx;margin-bottom:23rpx;border:1rpx solid #dde1e6;background:#fff;min-height:193rpx}
.next-leading{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;flex-shrink:0;background:#d0e2ff}.calendar-icon{width:46rpx;height:46rpx}
.next-copy{display:flex;flex:1;flex-direction:column;gap:4rpx;min-width:0}.next-title{font-size:26rpx;line-height:1.1;font-weight:500;color:#121619;word-break:break-all}.next-description{font-size:22rpx;line-height:1.4;color:#4d5358;word-break:break-all}
.view-button{display:flex;align-items:center;justify-content:center;flex-shrink:0;min-width:116rpx;width:auto;min-height:76rpx;margin:0;padding:18rpx 22rpx;border:2rpx solid #c1c7cd;border-radius:0;background:#fff;color:#121619;font-size:25rpx;line-height:1;font-weight:500}
.empty-services{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20rpx;min-height:260rpx;margin-bottom:38rpx;padding:30rpx;background:#fff;border:1rpx dashed #c1c7cd;font-size:25rpx;color:#697077}
.load-error{display:flex;align-items:center;gap:16rpx;margin-bottom:23rpx;padding:20rpx;background:#fff4e5;border:1rpx solid #e8c68a;font-size:23rpx;color:#805b14;line-height:1.5}.load-error>text{flex:1;min-width:0}.retry-button{min-height:62rpx;width:auto;padding:10rpx 18rpx;margin:0;background:transparent;color:#0f62fe;font-size:24rpx;border-radius:0;flex-shrink:0}
.home-overlay{position:fixed;inset:0;z-index:100}.home-mask{position:absolute;inset:0;background:#12161966}.home-sheet{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;padding:16rpx 0 env(safe-area-inset-bottom);background:#fff;box-shadow:0 -8rpx 40rpx #0000001a}
.sheet-handle{width:76rpx;height:8rpx;margin:0 auto 16rpx;border-radius:20rpx;background:#c1c7cd}.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:0 30rpx 16rpx;font-size:34rpx;font-weight:700}
.sheet-body{height:55vh;max-height:800rpx}.sheet-content{padding:0 30rpx 32rpx}.sheet-row{display:flex;align-items:center;gap:24rpx;min-height:130rpx;padding:24rpx 0;border-bottom:1rpx solid #dde1e6}.sheet-row>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}.sheet-row-title{font-size:29rpx;font-weight:500;line-height:1.3;color:#121619}.sheet-row-description{font-size:24rpx;line-height:1.4;color:#4d5358}.sheet-empty{padding:70rpx 20rpx;text-align:center;color:#697077;font-size:26rpx;line-height:1.6}
