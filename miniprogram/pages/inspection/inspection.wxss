.page{min-height:100vh;padding:30rpx;background:#f5f7fb;box-sizing:border-box}.form,.record{padding:30rpx;background:#fff;border-radius:18rpx}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.picker,.form textarea,.score-box input{width:100%;box-sizing:border-box;padding:22rpx;margin-bottom:18rpx;background:#f7f8fa;border-radius:10rpx}.form textarea{height:110rpx}.task-info{display:flex;justify-content:space-between;padding:0 8rpx 18rpx;color:#4e5969;font-size:25rpx}.progress{padding:18rpx;margin-bottom:18rpx;border-radius:10rpx;background:#eaf3ff;color:#1668dc;font-size:24rpx}.all-scored{padding:28rpx;margin-bottom:18rpx;text-align:center;border-radius:10rpx;background:#f6ffed;color:#389e0d}.score-box{padding:20rpx;margin-bottom:18rpx;border-radius:12rpx;background:#f7f8fa}.score-head{display:flex;justify-content:space-between;font-weight:600}.score-value{font-size:34rpx;color:#1677ff}.score-box input{margin:8rpx 0 0;background:#fff;text-align:center}.photos{display:flex;gap:14rpx;flex-wrap:wrap;margin:18rpx 0}.photo-wrap{position:relative}.photo-wrap image{width:150rpx;height:150rpx;border-radius:10rpx}.remove{position:absolute;right:-10rpx;top:-14rpx;width:38rpx;height:38rpx;line-height:34rpx;text-align:center;border-radius:50%;background:#f53f3f;color:#fff}.complete{margin-top:18rpx}.history{margin:38rpx 0 20rpx}.record{display:flex;flex-direction:column;gap:10rpx;margin-bottom:16rpx}.record-head{display:flex;justify-content:space-between;font-weight:600}.grade-text{color:#1677ff}.muted{color:#86909c;font-size:24rpx}.issue{color:#d4380d}.record-photos{white-space:nowrap}.record-photos image{width:130rpx;height:130rpx;border-radius:10rpx;margin-right:12rpx}.empty{text-align:center;color:#86909c;padding:40rpx}
.room-heading{margin-top:30rpx}.room-tabs{white-space:nowrap;margin-bottom:24rpx}.room-tab{display:inline-flex;flex-direction:column;gap:8rpx;padding:20rpx 24rpx;margin-right:14rpx;border:2rpx solid #e5e8ef;border-radius:14rpx;background:#fff;color:#344054}.room-tab.active{border-color:#1677ff;background:#edf5ff;color:#1668dc}.room-meta{font-size:22rpx;color:#667085}.room-panel{padding:22rpx 0;border-top:2rpx solid #eef0f4}.room-title{display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:30rpx}.legend{display:flex;gap:20rpx;margin-top:18rpx;color:#98a2b3;font-size:22rpx}.legend-used{color:#1677ff}.legend-done{color:#389e0d}.board-hint{font-size:22rpx;color:#86909c;margin:14rpx 0 20rpx}.seat-scroll{width:100%;background:#f6f8fc;border-radius:14rpx}.seat-board{position:relative;min-height:164rpx;margin:16rpx}.seat{position:absolute;box-sizing:border-box;width:176rpx;height:144rpx;padding:12rpx 8rpx;border:2rpx solid #dce1e9;border-radius:14rpx;background:#f0f2f5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;color:#98a2b3}.seat.in-use{background:#edf5ff;border-color:#91caff;color:#1668dc}.seat.scored{background:#f0fae8;border-color:#b7df8e;color:#389e0d}.seat.selected-seat{border:4rpx solid #1677ff;box-shadow:0 0 0 4rpx #d6e7ff}.seat-no{font-size:25rpx;font-weight:600;max-width:155rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.seat-person{font-size:25rpx;max-width:155rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.seat-state{font-size:20rpx}.seat.disabled{background:#eee;opacity:.7}.room-score{margin-top:22rpx;font-size:27rpx;color:#1668dc;background:#edf5ff}.rating-form{margin-top:24rpx;padding-top:22rpx;border-top:2rpx solid #e5eaf3}.rating-target{font-size:27rpx;font-weight:600;margin-bottom:22rpx;color:#1668dc;line-height:1.6}
