.page { min-height: 100vh; padding: 160rpx 50rpx; box-sizing: border-box; background: linear-gradient(160deg,#edf6ff,#f8fbff); }.brand { color: #0f62fe; font-size: 48rpx; font-weight: 600; text-align: center; margin-bottom: 80rpx; }.panel { padding: 40rpx; background: #fff; border-radius:6rpx; box-shadow: 0 12rpx 45rpx rgba(30,60,100,.08); }.panel input { padding: 25rpx 10rpx; margin-bottom: 25rpx; border-bottom: 1rpx solid #e5e6eb; }.panel button { margin-top: 35rpx; }.tip { display: block; margin-top: 30rpx; color: #86909c; font-size: 24rpx; text-align: center; }
.reset-title { color: #1d2129; font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 20rpx; }
.reset-tip { display: block; color: #86909c; font-size: 24rpx; line-height: 1.6; margin-bottom: 24rpx; }
.panel .back-button { background: #fff; color: #4e5969; border: 1rpx solid #c9cdd4; }
@import "../../styles/page.wxss";
.page{padding:64rpx 40rpx 70rpx;background:linear-gradient(155deg,#edf4ff 0%,#f2f4f8 55%)}.page-intro{margin-top:36rpx}.page-title{font-size:44rpx;max-width:550rpx}.page-caption{max-width:520rpx}.brand{font-size:23rpx;color:#697077;text-align:left;margin:0 0 34rpx;font-weight:400}.login-mark{display:grid;grid-template-columns:repeat(2,20rpx);gap:6rpx;margin:44rpx 0 16rpx}.login-mark view{width:20rpx;height:20rpx;border-radius:6rpx;background:#0f62fe}.login-mark view:last-child{background:#a6c8ff}.panel{padding:34rpx;border-radius:6rpx;box-shadow:0 18rpx 70rpx #00000000}.field-label{font-size:24rpx;font-weight:500;margin:10rpx 0 12rpx;color:#4d5358}.panel input{margin-bottom:24rpx}.panel button{margin-top:22rpx}.tip{line-height:1.6}.reset-title{font-size:31rpx;text-align:left}.reset-tip{color:#697077}.panel .back-button{background:#f2f4f8;color:#4d5358;border:none}

/* Unified native business-page appearance. */

.page{padding:54rpx 30rpx calc(46rpx + env(safe-area-inset-bottom));background:var(--canvas)}.page-intro{margin-top:20rpx}.page-title{font-size:40rpx;line-height:1.25}.page-caption{font-size:24rpx}.brand{font-size:23rpx;color:var(--muted);margin-bottom:30rpx}.login-mark{display:flex;flex-wrap:wrap;width:46rpx;gap:6rpx;margin:36rpx 0 18rpx}.login-mark view{width:20rpx;height:20rpx;border-radius:4rpx;background:var(--brand)}.login-mark view:last-child{background:#a6c8ff}.panel{padding:30rpx;border-radius:6rpx;box-shadow:none}.panel input{height:92rpx;min-height:92rpx;padding:0 22rpx;border:1rpx solid var(--line-strong);margin-bottom:24rpx}.field-label{color:var(--muted);font-size:25rpx}.panel .back-button{background:#fff;color:var(--ink);border:1rpx solid var(--line-strong)}.reset-title{text-align:left;font-size:32rpx}.reset-tip,.tip{color:var(--muted);line-height:1.6}
