.page { min-height: 100vh; padding: 160rpx 50rpx; box-sizing: border-box; background: linear-gradient(160deg,#edf6ff,#f8fbff); }.brand { color: #1677ff; font-size: 48rpx; font-weight: 600; text-align: center; margin-bottom: 80rpx; }.panel { padding: 40rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 12rpx 45rpx rgba(30,60,100,.08); }.panel input { padding: 25rpx 10rpx; margin-bottom: 25rpx; border-bottom: 1rpx solid #e5e6eb; }.panel button { margin-top: 35rpx; }.tip { display: block; margin-top: 30rpx; color: #86909c; font-size: 24rpx; text-align: center; }
.reset-title { color: #1d2129; font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 20rpx; }
.reset-tip { display: block; color: #86909c; font-size: 24rpx; line-height: 1.6; margin-bottom: 24rpx; }
.panel .back-button { background: #fff; color: #4e5969; border: 1rpx solid #c9cdd4; }
@import "../../styles/page.wxss";
.page{padding:64rpx 40rpx 70rpx;background:linear-gradient(155deg,#e6eee3 0%,#f3f5f3 55%)}.page-intro{margin-top:36rpx}.page-title{font-size:44rpx;max-width:550rpx}.page-caption{max-width:520rpx}.brand{font-size:23rpx;color:#708579;text-align:left;margin:0 0 34rpx;font-weight:400}.login-mark{display:grid;grid-template-columns:repeat(2,20rpx);gap:6rpx;margin:44rpx 0 16rpx}.login-mark view{width:20rpx;height:20rpx;border-radius:5rpx;background:#176b5b}.login-mark view:last-child{background:#9bb09a}.panel{padding:34rpx;border-radius:26rpx;box-shadow:0 18rpx 70rpx #274d3010}.field-label{font-size:24rpx;font-weight:500;margin:10rpx 0 12rpx;color:#4d6257}.panel input{margin-bottom:24rpx}.panel button{margin-top:22rpx}.tip{line-height:1.6}.reset-title{font-size:31rpx;text-align:left}.reset-tip{color:#829187}.panel .back-button{background:#f3f6f3;color:#536b5d;border:none}
