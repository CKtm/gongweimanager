<view class="page">
  <view class="page-intro"><text class="page-kicker">TEAM WORKSPACE</text><text class="page-title">导师工作台</text><text class="page-caption">团队工位、座位分配与日常审批</text></view>
  <view class="segmented"><view class="segment {{activeTab==='team'?'active':''}}" data-tab="team" bindtap="switchTab">团队</view><view class="segment {{activeTab==='assign'?'active':''}}" data-tab="assign" bindtap="switchTab">分配工位</view><view class="segment {{activeTab==='review'?'active':''}}" data-tab="review" bindtap="switchTab">待审批 {{applications.length + returns.length}}</view></view>
  <block wx:if="{{activeTab === 'team'}}"><view class="section-title">我的房间与固定工位</view>
  <view class="capacity"><view><text class="num">{{ownedRooms.length}}</text><text>工作室</text></view><view><text class="num">{{capacity.total}}</text><text>固定工位</text></view><view><text class="num available">{{capacity.available}}</text><text>空闲</text></view><view><text class="num">{{capacity.inUse}}</text><text>占用</text></view></view>
  <view wx:if="{{!ownedRooms.length}}" class="empty">暂无归属固定工位，请联系管理员划分</view>
  <view class="item" wx:for="{{ownedRooms}}" wx:key="roomId"><view class="title">{{item.roomName}}</view><view class="desc">{{item.location || '位置未填写'}} · 我的工位 {{item.workstationCount || 0}} · 空闲 {{item.availableCount || 0}}</view></view>

  <view class="section-title">团队工位</view>
  <view wx:if="{{!team.length}}" class="empty">尚未绑定指导学生</view>
  <view class="item" wx:for="{{team}}" wx:key="userId"><view class="title">{{item.nickName || item.userName}} <text class="identity">{{item.identityNo}}</text></view><view wx:if="{{item.assignment}}" class="station">{{item.assignment.roomName}} · {{item.assignment.workstationNo}}（{{item.assignment.workstationType === 'FIXED' ? '固定' : '流动'}}）<text wx:if="{{item.assignment.termCode}}" class="desc"> · 使用期限：{{item.assignment.termCode}}</text><button size="mini" type="warn" data-id="{{item.assignment.assignmentId}}" data-type="{{item.assignment.workstationType}}" bindtap="recall">{{item.assignment.workstationType === 'FIXED' ? '直接收回' : '发起收回'}}</button></view><view wx:else class="unassigned-row"><text class="desc">暂无有效工位</text><button size="mini" data-id="{{item.userId}}" bindtap="goAssign">分配工位</button></view></view>

  </block><block wx:if="{{activeTab === 'assign'}}"><view class="section-title">直接分配固定工位</view>
  <view class="form"><picker range="{{unassignedStudents}}" range-key="nickName" value="{{studentIndex}}" bindchange="onStudentChange"><view class="picker">学生：{{selectedStudentName}}</view></picker><picker range="{{fixedStations}}" range-key="label" value="{{stationIndex}}" bindchange="onStationChange"><view class="picker">工位：{{selectedStationName}}</view></picker><picker mode="date" value="{{usageStart}}" disabled="{{submitting}}" data-field="usageStart" bindchange="onUsageDate"><view class="picker">开始日期：{{usageStart || '请选择'}} ▾</view></picker><picker mode="date" value="{{usageEnd}}" start="{{usageStart}}" disabled="{{submitting}}" data-field="usageEnd" bindchange="onUsageDate"><view class="picker">结束日期：{{usageEnd || '请选择'}} ▾</view></picker><button type="primary" loading="{{submitting}}" disabled="{{submitting || !unassignedStudents.length || !fixedStations.length}}" bindtap="assignFixed">确认分配</button></view>

  </block><block wx:if="{{activeTab === 'review'}}"><view class="section-title">流动工位初审（{{applications.length}}）</view>
  <view wx:if="{{availableFixedCount > 0 && applications.length}}" class="warning">当前仍有 {{availableFixedCount}} 个可分配固定工位，流动申请不能通过，应先分配固定工位。</view>
  <view wx:if="{{!applications.length}}" class="empty">暂无待审核流动申请</view>
  <view class="item" wx:for="{{applications}}" wx:key="applicationId"><view class="title">{{item.studentName}} · 申请 #{{item.applicationId}}</view><view class="desc">{{item.reason}}</view><view class="desc">{{item.plannedStart || '-'}} 至 {{item.plannedEnd || '-'}}</view><view class="actions"><button size="mini" type="primary" disabled="{{availableFixedCount > 0}}" data-id="{{item.applicationId}}" data-status="APPROVED" bindtap="reviewApplication">同意</button><button size="mini" type="warn" data-id="{{item.applicationId}}" data-status="REJECTED" bindtap="reviewApplication">驳回</button></view></view>

  <view class="section-title">退还确认（{{returns.length}}）</view>
  <view wx:if="{{!returns.length}}" class="empty">暂无待确认退还申请</view>
  <view class="item" wx:for="{{returns}}" wx:key="returnId"><view class="title">{{item.studentName}} · {{item.roomName}} / {{item.workstationNo}}</view><view class="desc">{{item.reason}}</view><view wx:if="{{item.photoList.length}}" class="return-photos"><image wx:for="{{item.photoList}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.photoList}}" bindtap="previewReturnPhoto"/></view><view class="actions"><button size="mini" type="primary" data-id="{{item.returnId}}" data-status="APPROVED" bindtap="reviewReturn">同意</button><button size="mini" type="warn" data-id="{{item.returnId}}" data-status="REJECTED" bindtap="reviewReturn">驳回</button></view></view>
  </block>
</view>
