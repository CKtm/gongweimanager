.page{min-height:100vh;padding:30rpx;background:#f5f7fb}.section-title{margin:28rpx 4rpx 16rpx;font-size:29rpx;font-weight:600;color:#4e5969}.item,.form{padding:26rpx;margin-bottom:18rpx;background:#fff;border-radius:16rpx}.title{font-size:30rpx;font-weight:600}.identity{margin-left:12rpx;color:#86909c;font-size:23rpx;font-weight:400}.desc{margin-top:10rpx;color:#86909c;font-size:25rpx}.station{margin-top:12rpx;color:#1677ff;font-size:25rpx;display:flex;align-items:center;justify-content:space-between}.actions{display:flex;gap:16rpx;margin-top:18rpx}.empty,.warning{padding:34rpx;text-align:center;color:#86909c;background:#fff;border-radius:16rpx}.warning{color:#d46b08;background:#fff7e6}.form input,.picker{width:100%;margin-bottom:16rpx;padding:20rpx;box-sizing:border-box;background:#f7f8fa;border-radius:10rpx}.capacity{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.capacity view{display:flex;flex-direction:column;align-items:center;padding:20rpx 8rpx;background:#fff;border-radius:14rpx;color:#86909c;font-size:22rpx}.num{font-size:36rpx;font-weight:600;color:#1d2129}.num.available{color:#07c160}
.return-photos{display:flex;gap:12rpx;margin-top:16rpx}.return-photos image{width:126rpx;height:126rpx;border-radius:10rpx}
@import "../../styles/page.wxss";
.capacity{gap:10rpx;margin-bottom:26rpx}.capacity view{padding:24rpx 6rpx}.section-title{margin-top:28rpx}.item .title{font-size:29rpx}.item .desc{font-size:24rpx}.station{flex-wrap:wrap;line-height:1.6;color:var(--brand)}.station button{margin-left:auto}.unassigned-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.unassigned-row button{margin:14rpx 0 0;color:var(--brand);background:var(--brand-soft)}.actions button[type=warn]{background:#f8ede9;color:#ad6251}.identity{font-size:22rpx}
