<view class="page">
  <view class="page-intro"><text class="page-kicker">MY WORKSPACE</text><text class="page-title">我的工位</text><text class="page-caption">属于你的专注空间</text></view><view wx:if="{{!list.length}}" class="empty">当前没有已分配工位</view><view wx:for="{{list}}" wx:key="assignmentId" class="card"><view class="title">{{item.roomName}} · {{item.workstationNo}}</view><view class="muted">{{item.workstationType === 'FIXED' ? '固定工位' : '流动工位'}}</view><view class="muted">分配时间：{{item.startedAt}}</view></view></view>
