<view class="page">
  <view class="page-intro"><text class="page-kicker">MY WORKSPACE</text><text class="page-title">我的工位</text><text class="page-caption">属于你的专注空间</text></view><view wx:if="{{!list.length}}" class="empty">当前没有已分配工位</view><view wx:for="{{list}}" wx:key="assignmentId" class="card"><view class="title">{{item.roomName}} · {{item.workstationNo}}</view><view class="muted">{{item.workstationType === 'FIXED' ? '固定工位' : '流动工位'}}</view><view wx:if="{{!item.endedAt && item.workstationStatus==='DISABLED'}}" class="notice">工位已停用：暂时禁止使用，座位仍为你保留，请联系管理员处理。</view><view class="muted">分配时间：{{item.startedAt}}</view><view wx:if="{{item.termCode}}" class="muted">使用期限：{{item.termCode}}</view></view></view>
