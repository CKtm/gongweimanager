.page{min-height:100vh;padding:30rpx;background:#f5f7fb}.card{padding:30rpx;margin-bottom:20rpx;background:#fff;border-radius:6rpx}.title{font-size:34rpx;font-weight:600}.muted{margin-top:12rpx;color:#86909c;font-size:25rpx}.empty{padding:100rpx 0;text-align:center;color:#86909c}
@import "../../styles/page.wxss";
.card{position:relative;background:#ffffff;color:#fff;border:none;padding:40rpx;overflow:hidden}.card::after{content:'';position:absolute;width:160rpx;height:160rpx;border:26rpx solid #ffffff08;border-radius:6rpx;right:-50rpx;top:-30rpx;transform:rotate(20deg)}.card .title{font-size:42rpx;color:#fff;margin:14rpx 0 32rpx}.card .muted{color:#4d5358;font-size:25rpx}

/* Unified native business-page appearance. */

.card{background:#fff;color:var(--ink);border:1rpx solid var(--line);padding:34rpx;border-radius:6rpx}.card::after{display:none}.card .title{font-size:34rpx;font-weight:700;color:var(--ink);margin:0 0 24rpx}.card .muted{font-size:25rpx;color:var(--muted);line-height:1.6;word-break:break-all}
