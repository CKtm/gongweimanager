  <view class="page-intro"><text class="page-kicker">ACCOUNT SECURITY</text><text class="page-title">账号安全</text><text class="page-caption">设置新的登录密码，保护你的个人信息</text></view><view class="panel"><input password placeholder="初始密码" data-field="oldPassword" bindinput="onInput" /><input password placeholder="新密码（5-20位）" data-field="newPassword" bindinput="onInput" /><input password placeholder="确认新密码" data-field="confirmPassword" bindinput="onInput" /><button type="primary" loading="{{saving}}" bindtap="submit">保存并进入系统</button></view></view>
