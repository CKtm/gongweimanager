.page { min-height: 100vh; padding: 160rpx 50rpx; box-sizing: border-box; background: #f5f7fb; }.title { margin-bottom: 50rpx; font-size: 40rpx; font-weight: 600; text-align: center; }.panel { padding: 40rpx; background: #fff; border-radius:6rpx; }.panel input { padding: 26rpx 10rpx; margin-bottom: 22rpx; border-bottom: 1rpx solid #e5e6eb; }.panel button { margin-top: 30rpx; }
@import "../../styles/page.wxss";
.page{padding-top:64rpx}.panel{margin-top:40rpx}.title{color:var(--ink)}

/* Unified native business-page appearance. */

.page{padding:44rpx 30rpx calc(46rpx + env(safe-area-inset-bottom))}.panel{padding:30rpx;margin-top:30rpx}.panel input{height:92rpx;min-height:92rpx;padding:0 22rpx;border:1rpx solid var(--line-strong);margin-bottom:24rpx}.panel button{margin-top:24rpx}
