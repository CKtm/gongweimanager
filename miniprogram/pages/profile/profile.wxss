.page{min-height:100vh;padding:36rpx;background:#f5f7fb;box-sizing:border-box}.header{display:flex;align-items:center;gap:24rpx;padding:36rpx;background:linear-gradient(135deg,#2f80ed,#56ccf2);color:#fff;border-radius:22rpx}.avatar{width:92rpx;height:92rpx;line-height:92rpx;text-align:center;border-radius:50%;background:rgba(255,255,255,.25);font-size:42rpx}.name,.role{display:block}.name{font-size:36rpx;font-weight:600}.role{margin-top:10rpx;font-size:24rpx;opacity:.9}.card{margin-top:28rpx;padding:10rpx 28rpx;background:#fff;border-radius:20rpx}.line{display:flex;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #f0f1f2;color:#4e5969}.line:last-child{border:0}.notice{margin-top:24rpx;padding:22rpx;border-radius:14rpx;background:#fff7e8;color:#d46b08;font-size:25rpx;line-height:1.6}.password{margin-top:34rpx;background:#fff;color:#2f80ed}
@import "../../styles/page.wxss";
.header{background:#e5ede3;color:#294b39;border:1rpx solid #dce6d8;padding:32rpx}.avatar{background:#fff;color:#476e50;border-radius:24rpx;font-weight:600}.name{color:#294b39}.role{color:#6c8471}.line{gap:24rpx;font-size:26rpx;border-color:var(--line);align-items:flex-start}.line text:first-child{color:#829087;flex-shrink:0}.line text:last-child{text-align:right;word-break:break-all}.password{display:flex;justify-content:space-between;margin:0;background:#fff;color:var(--ink);border:1rpx solid var(--line);border-radius:20rpx;text-align:left;padding:26rpx}.password text{color:#8c9a91}.signout{margin-top:24rpx;font-size:25rpx;background:transparent;color:#a06050}
