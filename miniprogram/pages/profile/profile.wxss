page{--brand:#0f62fe;--canvas:#f2f4f8;--ink:#121619;--muted:#4d5358;background:#f2f4f8;color:#121619;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;line-height:1.4}
.profile-page{min-height:100vh;background:#f2f4f8}.profile-top-shell{position:sticky;top:0;z-index:25;background:#fff}.profile-top-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding-left:16rpx;min-height:92rpx;border-bottom:1rpx solid #dde1e6;font-size:34rpx;line-height:1.1;font-weight:700}.profile-top-bar>text{flex:1;min-width:0;white-space:nowrap}.settings-button{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;min-height:76rpx;padding:18rpx;margin:0;background:transparent;border-radius:0;flex-shrink:0}.settings-icon{width:38rpx;height:38rpx}
.profile-content{display:flex;flex-direction:column;gap:30rpx;padding:30rpx}.profile-header{display:flex;align-items:center;gap:23rpx;width:100%}.avatar-button,.avatar-image{width:92rpx;height:92rpx;border-radius:50%;flex-shrink:0}.avatar-button{display:flex;align-items:center;justify-content:center;overflow:hidden;background:#dde1e6;color:#4d5358;font-size:38rpx;font-weight:500}.avatar-image{display:block}.profile-heading{display:flex;flex-direction:column;gap:4rpx;flex:1;min-width:0}.profile-name{font-size:30rpx;font-weight:500;line-height:1.1;color:#121619;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.profile-role{font-size:25rpx;line-height:1.4;color:#4d5358;word-break:break-all}.edit-button{display:flex;align-items:center;justify-content:center;width:auto;min-width:102rpx;min-height:76rpx;margin:0;padding:18rpx 22rpx;border:2rpx solid #c1c7cd;border-radius:0;background:transparent;font-size:25rpx;font-weight:500;line-height:1;color:#121619;flex-shrink:0}
.identity-card{display:flex;flex-direction:column;gap:16rpx;width:100%;padding:46rpx;background:#fff;border:1rpx solid #dde1e6}.identity-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:14rpx;font-size:30rpx;font-weight:500;line-height:1.1}.profile-badge{display:flex;align-items:center;gap:8rpx;flex-shrink:0;min-height:38rpx;padding:4rpx 15rpx;border-radius:100rpx;background:#a7f0ba;color:#198038;font-size:22rpx;line-height:1.4;font-weight:400}.profile-badge.pending-badge{background:#fff4e5;color:#805b14}.status-dot{width:12rpx;height:12rpx}.progress-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:25rpx;line-height:1.4;color:#21272a}.progress-value{font-weight:500;color:#121619}.progress-track{height:16rpx;width:100%;border-radius:100rpx;overflow:hidden;background:#dde1e6}.progress-fill{height:100%;background:#0f62fe;border-radius:100rpx}.progress-caption{font-size:22rpx;line-height:1.4;color:#4d5358;word-break:break-all}.profile-action{display:flex;align-items:center;justify-content:center;width:100%;min-height:76rpx;margin:14rpx 0 0;padding:18rpx 22rpx;background:#fff;color:#121619;border:2rpx solid #c1c7cd;border-radius:0;font-size:25rpx;font-weight:500;line-height:1.2}
.profile-stats{display:flex;gap:23rpx;width:100%}.stat-card{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx;padding:23rpx;background:#fff;border:1rpx solid #dde1e6}.stat-value{font-size:34rpx;font-weight:700;line-height:1.1;color:#121619}.stat-label{font-size:22rpx;line-height:1.4;color:#4d5358}
.settings-list{width:100%;border:1rpx solid #dde1e6;background:#fff}.settings-row{display:flex;align-items:center;gap:23rpx;min-height:107rpx;padding:23rpx 30rpx;border-bottom:1rpx solid #dde1e6}.settings-row:last-child{border-bottom:none}.row-icon-holder{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;background:#d0e2ff}.row-icon{width:31rpx;height:31rpx}.settings-row>text{flex:1;min-width:0;font-size:30rpx;font-weight:500;line-height:1.1;color:#121619;word-break:break-all}.chevron{width:38rpx;height:38rpx;flex-shrink:0}.readonly-note{font-size:22rpx;line-height:1.5;color:#697077;text-align:center;margin-top:-10rpx}.logout-button{width:100%;min-height:88rpx;padding:22rpx;margin:0;background:#fff;border:1rpx solid #dde1e6;border-radius:0;color:#b42318;font-size:26rpx;font-weight:400;line-height:1.4}.binding-notice{padding:22rpx 24rpx;background:#fff4e5;color:#805b14;border:1rpx solid #e8c68a;font-size:24rpx;line-height:1.6}.profile-error{display:flex;align-items:center;gap:16rpx;padding:20rpx;background:#fff4e5;border:1rpx solid #e8c68a;color:#805b14;font-size:23rpx;line-height:1.5}.profile-error>text{flex:1;min-width:0}.profile-error button{width:auto;min-height:62rpx;padding:10rpx 18rpx;margin:0;background:transparent;color:#0f62fe;font-size:24rpx;border-radius:0;flex-shrink:0}
