<view class="page">
  <view class="page-intro"><text class="page-kicker">FIXED WORKSTATIONS</text><text class="page-title">我的固定工位</text><text class="page-caption">管理员划分给导师，导师再分配给学生</text></view>
  <view class="notice">固定工位由管理员直接划分，无需提交申请。可在导师工作台将名下工位分配给自己的学生。</view>
  <view class="section-title history">我的固定工位所在房间</view>
  <view wx:if="{{!ownedRooms.length}}" class="empty">暂无归属固定工位</view>
  <view wx:for="{{ownedRooms}}" wx:key="roomId" class="item"><view><text class="name">{{item.roomName}}</text><text class="comment">{{item.location || '位置未填写'}}</text></view><view class="numbers"><text>我的工位 {{item.workstationCount || 0}}</text><text class="remaining">空闲 {{item.availableCount || 0}}</text><text>占用 {{item.inUseCount || 0}}</text></view></view>
  <view class="section-title history">历史工作室申请记录</view>
  <view wx:if="{{!list.length}}" class="empty">暂无历史工作室申请记录</view>
  <view wx:for="{{list}}" wx:key="studioApplicationId" class="item"><view><text class="name">{{item.roomName}} · {{item.location || '位置未填写'}}</text><text class="comment">{{item.reason}}</text><text wx:if="{{item.adminComment}}" class="comment">管理员意见：{{item.adminComment}}</text></view><view><text class="status">{{item.statusText}}</text><text class="approved">{{item.workstationCount || 0}} 个工位</text></view></view>
</view>
