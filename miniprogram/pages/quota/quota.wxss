.page{min-height:100vh;padding:30rpx;background:#f5f7fb}.notice{padding:22rpx;margin-bottom:20rpx;border-radius:6rpx;background:#e8f3ff;color:#0f62fe;font-size:24rpx}.form{padding:30rpx;background:#fff;border-radius:6rpx}.form textarea,.picker{width:100%;box-sizing:border-box;padding:22rpx;margin-bottom:18rpx;background:#f7f8fa;border-radius:6rpx}.form textarea{height:120rpx}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.history{margin:36rpx 0 20rpx}.item{display:flex;justify-content:space-between;padding:24rpx;margin-bottom:14rpx;background:#fff;border-radius:6rpx}.status{color:#0f62fe}
.empty{padding:40rpx;text-align:center;color:#909399}.name{font-weight:600}.comment,.approved{display:block;margin-top:8rpx;font-size:24rpx;color:#606266}.numbers{display:flex;flex-direction:column;text-align:right;font-size:24rpx}.remaining{color:#0f62fe;font-weight:600}.approved{color:#0f62fe}
@import "../../styles/page.wxss";
.item{gap:22rpx}.item>view:first-child{flex:1;min-width:0}.item .name{display:block;font-size:28rpx;line-height:1.6}.numbers{flex-shrink:0;min-width:105rpx;padding-left:18rpx;border-left:1rpx solid var(--line);gap:6rpx}.numbers .remaining{font-size:26rpx}.item .status{display:inline-block;white-space:nowrap}

/* Unified native business-page appearance. */

.numbers{min-width:122rpx;padding-left:20rpx;gap:8rpx}.numbers .remaining{color:var(--brand);font-size:26rpx}.history{font-weight:500;font-size:30rpx}.item .status{font-size:21rpx}.item .approved{color:var(--muted)}
