.page{min-height:100vh;padding:30rpx;background:#f5f7fb}.notice{padding:22rpx;margin-bottom:20rpx;border-radius:12rpx;background:#e8f3ff;color:#1677ff;font-size:24rpx}.form{padding:30rpx;background:#fff;border-radius:18rpx}.form textarea,.picker{width:100%;box-sizing:border-box;padding:22rpx;margin-bottom:18rpx;background:#f7f8fa;border-radius:10rpx}.form textarea{height:120rpx}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.history{margin:36rpx 0 20rpx}.item{display:flex;justify-content:space-between;padding:24rpx;margin-bottom:14rpx;background:#fff;border-radius:14rpx}.status{color:#1677ff}
.empty{padding:40rpx;text-align:center;color:#909399}.name{font-weight:600}.comment,.approved{display:block;margin-top:8rpx;font-size:24rpx;color:#606266}.numbers{display:flex;flex-direction:column;text-align:right;font-size:24rpx}.remaining{color:#07c160;font-weight:600}.approved{color:#07c160}
@import "../../styles/page.wxss";
.item{gap:22rpx}.item>view:first-child{flex:1;min-width:0}.item .name{display:block;font-size:28rpx;line-height:1.6}.numbers{flex-shrink:0;min-width:105rpx;padding-left:18rpx;border-left:1rpx solid var(--line);gap:6rpx}.numbers .remaining{font-size:26rpx}.item .status{display:inline-block;white-space:nowrap}
