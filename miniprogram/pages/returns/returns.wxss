.page{min-height:100vh;padding:30rpx;background:#f5f7fb}.form{padding:30rpx;background:#fff;border-radius:6rpx}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.form textarea{width:100%;height:160rpx;padding:20rpx;box-sizing:border-box;background:#f7f8fa;border-radius:6rpx;margin-bottom:20rpx}.history{margin:40rpx 0 20rpx}.item{display:flex;justify-content:space-between;padding:24rpx;margin-bottom:16rpx;background:#fff;border-radius:6rpx}.name,.desc,.status{display:block}.desc{margin-top:10rpx;color:#86909c;font-size:24rpx}.status{color:#0f62fe;font-size:24rpx;margin-bottom:8rpx}
.empty{padding:40rpx;text-align:center;color:#909399}.content{width:100%}.row{display:flex;justify-content:space-between;align-items:center}.comment{display:block;margin:10rpx 0;font-size:24rpx;color:#606266}
.notice,.hint{padding:24rpx;margin-bottom:20rpx;border-radius:6rpx;background:#fff7e6;color:#ad6800;font-size:25rpx}.hint{padding:0;background:transparent;color:#86909c}.photos{display:flex;flex-wrap:wrap;gap:14rpx;margin:18rpx 0}.photo-wrap{position:relative}.photos image{width:150rpx;height:150rpx;border-radius:6rpx}.remove{position:absolute;right:-10rpx;top:-12rpx;width:36rpx;height:36rpx;line-height:34rpx;text-align:center;border-radius:50%;background:#f56c6c;color:#fff}.source{display:block;margin-top:8rpx;color:#0f62fe;font-size:23rpx}.record-photos image{width:120rpx;height:120rpx}.reupload-form{margin-top:24rpx}.action-row{display:flex;justify-content:flex-end;gap:16rpx}
@import "../../styles/page.wxss";
.item .source{display:inline-block;font-size:21rpx;background:#f2f4f8;border-radius:6rpx;padding:3rpx 10rpx;margin:8rpx 0}.hint{padding:0;border:none;background:none}.record-photos{margin-top:20rpx}.item .name{font-size:28rpx;font-weight:600}.action-row{justify-content:flex-end}.comment{font-size:24rpx}

/* Unified native business-page appearance. */

.form textarea{border:1rpx solid var(--line-strong);background:#f2f4f8;border-radius:6rpx}.item .source{background:#edf4ff;color:#002d9c;border-radius:100rpx;padding:4rpx 12rpx}.item .status{font-size:21rpx;white-space:nowrap}.photos image{border-radius:6rpx}.hint{border:none;background:transparent;color:var(--subtle)}
