.page{min-height:100vh;padding:30rpx;background:#f5f7fb;box-sizing:border-box}
.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}
.summary view{padding:24rpx 10rpx;text-align:center;background:#fff;border-radius:16rpx}
.summary .number,.summary text{display:block}
.summary .number{font-size:38rpx;color:#1677ff;font-weight:600}
.summary text{margin-top:6rpx;color:#86909c;font-size:23rpx}
.filters{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:12rpx;margin-top:22rpx}
.filters picker{padding:18rpx 10rpx;text-align:center;background:#fff;border-radius:12rpx;color:#4e5969;font-size:24rpx}
.apply{margin:20rpx 0 0 auto;background:#1677ff;color:#fff}
.empty{padding:100rpx 0;text-align:center;color:#86909c}
.room{margin-top:26rpx}.room-title{display:flex;justify-content:space-between;margin-bottom:14rpx;font-size:30rpx;font-weight:600}
.room-title text{color:#86909c;font-size:23rpx;font-weight:400}
.room-title .room-type{margin-left:12rpx;color:#1677ff}.room-meta{margin:-6rpx 0 14rpx;color:#86909c;font-size:23rpx}
.station-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}
.station{min-height:150rpx;padding:18rpx;border:2rpx solid #dcdfe6;border-radius:14rpx;background:#fff;box-sizing:border-box}
.station text{display:block}.no{font-size:29rpx;font-weight:600}.type,.status,.position{margin-top:7rpx;font-size:21rpx;color:#606266}
.station.available{border-color:#67c23a;background:#f0f9eb}.station.in_use{border-color:#e6a23c;background:#fdf6ec}.station.pending_return{border-color:#f56c6c;background:#fef0f0}.station.disabled{border-color:#909399;background:#f4f4f5;color:#909399}
@import "../../styles/page.wxss";
.filters{position:sticky;top:0;z-index:10;padding:18rpx 0;background:var(--canvas);margin-top:10rpx}.filters picker{border:1rpx solid var(--line);padding:18rpx 8rpx;color:#536a5a}.apply{background:var(--brand);border-radius:14rpx;margin:6rpx 0 18rpx auto}.room{background:#fff;padding:28rpx;border-radius:24rpx;border:1rpx solid var(--line)}.room-title .room-type{display:inline-block;font-size:20rpx;color:var(--brand);background:var(--brand-soft);padding:2rpx 10rpx;border-radius:8rpx}.room-title{align-items:center;gap:14rpx}.room-title>view{flex:1}.room-meta{line-height:1.7}.station-grid{gap:12rpx;margin-top:20rpx}.station{min-height:150rpx;padding:16rpx 12rpx;border-radius:16rpx}.station.available{border-color:#cfe4d6;background:#f0f7f1}.station.in_use{border-color:#dae3ec;background:#f1f5f8}.station.pending_return{border-color:#e9d9b9;background:#fcf7ec}.station.disabled{border-color:#e5e9e6;background:#f4f5f3}.no{font-size:30rpx}.type,.position{font-size:20rpx;color:#8d9a92}.station .status{background:transparent;padding:0;color:#5c7263;font-size:21rpx}
.search-bar{display:flex;align-items:center;gap:16rpx;padding:18rpx 22rpx;margin-top:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:18rpx}.search-bar input{flex:1;min-width:0;font-size:25rpx;height:44rpx}.search-symbol{color:#80968a;font-size:36rpx;line-height:1}.clear-search{padding:0 10rpx;color:#8b9a91;font-size:32rpx}
