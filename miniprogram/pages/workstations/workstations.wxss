page{--brand:#0f62fe;--canvas:#fff;--ink:#121619;--muted:#4d5358;background:#fff;color:#121619;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;line-height:1.4}
.studios-page{min-height:100vh;background:#fff}.top-shell{position:sticky;top:0;z-index:25;background:#fff}.top-bar{display:flex;align-items:center;gap:16rpx;padding-left:16rpx;border-bottom:1rpx solid #dde1e6;min-height:92rpx}.page-heading{flex:1;min-width:0;font-size:34rpx;line-height:1.1;font-weight:700;white-space:nowrap}.top-actions{display:flex;align-items:center;gap:8rpx;flex-shrink:0}.icon-button{position:relative;display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;min-height:76rpx;padding:18rpx;margin:0;border-radius:8rpx;background:transparent}.icon-button.is-active{background:#edf4ff}.tool-icon{display:block;width:38rpx;height:38rpx}.filter-badge{position:absolute;right:2rpx;top:0;display:flex;align-items:center;justify-content:center;min-width:28rpx;height:28rpx;padding:0 6rpx;border-radius:16rpx;background:#0f62fe;color:white;font-size:18rpx}.search-panel{display:flex;align-items:center;gap:16rpx;padding:20rpx 30rpx;border-bottom:1rpx solid #dde1e6;background:#fff}.search-icon{width:34rpx;height:34rpx;flex-shrink:0}.search-input{flex:1;min-width:0;height:66rpx;font-size:25rpx;line-height:1.4}.clear-button{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;min-height:64rpx;padding:13rpx;margin:0;background:transparent;border-radius:8rpx;flex-shrink:0}.small-icon{width:38rpx;height:38rpx}.map-area{position:relative;height:796rpx;overflow:hidden;background:#f2f4f8}.map-image{position:absolute;top:0;left:calc(50% + 4.3rpx);transform:translateX(-50%);width:1228.05rpx;height:806.1rpx;max-width:none}.map-caption{position:absolute;top:24rpx;left:30rpx;padding:8rpx 16rpx;background:#ffffffed;border:1rpx solid #dde1e6;border-radius:6rpx;color:#4d5358;font-size:21rpx;line-height:1.4}.map-summary{position:absolute;right:30rpx;bottom:26rpx;display:flex;align-items:center;gap:8rpx;padding:14rpx 20rpx;background:#fff;border:1rpx solid #dde1e6;box-shadow:0 4rpx 18rpx #0000000c;font-size:22rpx;color:#4d5358}.summary-number{color:#121619;font-size:28rpx;font-weight:600}.brand{color:#0f62fe}.summary-divider{width:1rpx;height:26rpx;margin:0 8rpx;background:#dde1e6}.room-sheet{position:relative;z-index:2;background:#fff;padding:16rpx 30rpx 32rpx;box-shadow:2rpx -4rpx 24rpx #0000000a}.sheet-handle{width:76rpx;height:8rpx;border-radius:20rpx;background:#c1c7cd;margin:0 auto 30rpx}.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:28rpx}.sheet-title{font-size:34rpx;font-weight:700;line-height:1.1}.sheet-subtitle{font-size:21rpx;color:#697077}.room-row{display:flex;align-items:center;gap:22rpx;padding:24rpx 30rpx;min-height:122rpx;border-bottom:1rpx solid #dde1e6}.room-row:last-child{border-bottom:none}.room-row.selected-row{background:#f2f6ff}.room-leading{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:62rpx;height:62rpx;border-radius:50%;background:#d0e2ff}.pin-icon{width:32rpx;height:32rpx}.room-copy{display:flex;flex:1;flex-direction:column;gap:4rpx;min-width:0}.room-name{font-size:30rpx;line-height:1.1;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.room-description{font-size:24rpx;line-height:1.4;color:#4d5358;word-break:break-all}.room-availability{font-size:24rpx;line-height:1.4;color:#697077;white-space:nowrap;flex-shrink:0}.room-availability.has-seats{color:#0f62fe}.chevron{width:38rpx;height:38rpx;flex-shrink:0}.chevron-open{transform:rotate(90deg)}.loading-state{display:flex;align-items:center;justify-content:center;gap:16rpx;padding:30rpx;color:#697077;font-size:25rpx}.loading-dot{width:12rpx;height:12rpx;border-radius:50%;background:#0f62fe}.error-state,.empty-state{padding:36rpx 16rpx;text-align:center;font-size:25rpx;line-height:1.6;color:#697077}.empty-title{display:block;font-size:29rpx;font-weight:500;color:#21272a;margin-bottom:12rpx}.error-state>text{display:block}.text-action{width:auto;min-height:72rpx;display:inline-flex;align-items:center;justify-content:center;margin:18rpx 0 0;padding:12rpx 20rpx;background:transparent;color:#0f62fe;font-size:25rpx;border-radius:4rpx}.room-detail{margin-top:30rpx;padding-top:30rpx;border-top:1rpx solid #dde1e6}.detail-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.detail-heading>view{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0}.detail-title{font-size:32rpx;font-weight:700;line-height:1.2;word-break:break-all}.detail-type{padding:5rpx 10rpx;background:#edf4ff;font-size:20rpx;color:#0f62fe;white-space:nowrap}.detail-mentor{display:block;font-size:24rpx;color:#4d5358;margin:6rpx 0 20rpx;line-height:1.6}.seat-legend{display:flex;flex-wrap:wrap;gap:20rpx;margin:18rpx 0 24rpx;font-size:21rpx;color:#697077}.legend-dot{font-size:20rpx}.available-dot{color:#0f62fe}.occupied-dot{color:#4d5358}.pending-dot{color:#b28600}.disabled-dot{color:#a2a9b0}.seat-grid{display:flex;flex-wrap:wrap;gap:14rpx}.seat{width:calc((100% - 28rpx)/3);min-height:160rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;border:1rpx solid #dde1e6;background:#f2f4f8;padding:18rpx 8rpx;border-radius:8rpx}.seat.available{background:#edf4ff;border-color:#a6c8ff}.seat.in_use{background:#f2f4f8;border-color:#c1c7cd}.seat.pending_return{background:#fff8e1;border-color:#dfbd58}.seat.disabled{background:#f2f4f8;border-color:#dde1e6;color:#a2a9b0}.seat-number{font-size:29rpx;font-weight:600;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.seat-type,.seat-status{font-size:21rpx;color:#4d5358}.seat.available .seat-status{color:#0f62fe}.empty-seats{padding:36rpx 0;text-align:center;font-size:25rpx;color:#697077}.apply-button{margin:30rpx 0 0;background:#0f62fe!important;border-radius:4rpx;min-height:92rpx;padding:24rpx;font-size:28rpx;font-weight:500}.filter-overlay{position:fixed;inset:0;z-index:100}.filter-mask{position:absolute;inset:0;background:#12161966}.filter-sheet{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;background:#fff;padding-top:16rpx;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -8rpx 40rpx #0000001a}.filter-sheet .sheet-handle{margin-bottom:16rpx}.filter-heading{display:flex;align-items:center;justify-content:space-between;padding:0 30rpx 12rpx;font-size:34rpx;font-weight:700}.filter-body{height:510rpx;max-height:55vh}.filter-content{padding:0 30rpx 20rpx}.field-label{display:block;margin:20rpx 0 12rpx;color:#4d5358;font-size:25rpx}.picker-field{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 24rpx;min-height:92rpx;background:#f2f4f8;border:1rpx solid #dde1e6;font-size:28rpx;border-radius:4rpx}.picker-chevron{width:38rpx;height:38rpx;transform:rotate(90deg);flex-shrink:0}.filter-footer{display:flex;gap:20rpx;padding:24rpx 30rpx;border-top:1rpx solid #dde1e6}.filter-footer button{margin:0;flex:1;min-height:92rpx;border-radius:4rpx;padding:24rpx;font-size:28rpx}.filter-footer .reset-button{background:#fff;border:2rpx solid #0f62fe;color:#0f62fe}.filter-footer .confirm-button{flex:2;background:#0f62fe}
