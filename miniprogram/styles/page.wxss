.page{min-height:100vh;box-sizing:border-box;padding:32rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));background:var(--canvas);color:var(--ink)}
.form,.panel,.card,.item,.record{background:#fff;border-radius:var(--radius);border:1rpx solid var(--line);box-shadow:0 4rpx 16rpx #1c3e2c03}.form,.panel{padding:30rpx}.item,.record{padding:28rpx;margin-bottom:18rpx}.card{padding:30rpx}.section-title{font-size:30rpx;color:var(--ink);font-weight:600;line-height:1.5}.name,.title{color:var(--ink)}.muted,.desc,.comment,.meta,.hint{color:var(--muted);line-height:1.7}.desc{max-width:100%;word-break:break-all}.row{gap:16rpx;align-items:flex-start}.row .name{flex:1;min-width:0}.row .status{flex-shrink:0}.status{color:var(--brand);background:var(--brand-soft);border-radius:9rpx;padding:4rpx 12rpx;font-size:22rpx;line-height:1.6}.empty{padding:48rpx 24rpx;text-align:center;color:#8a9991;background:#fff;border:1rpx dashed #dbe5de;border-radius:20rpx;font-size:25rpx;line-height:1.7}.notice,.progress,.eligibility{padding:22rpx 24rpx;line-height:1.7;border-radius:16rpx;font-size:24rpx;background:var(--brand-soft);color:#376655;border:1rpx solid #dcebe1}.warning,.eligibility.blocked{background:#fbf4e8;color:#947034;border-color:#f0e6d1}.eligibility.allowed{background:var(--brand-soft);color:var(--brand)}.form textarea,.form input,.panel input,.picker{background:#f5f7f5;border:1rpx solid #eaf0eb;border-radius:14rpx;padding:22rpx;font-size:27rpx}.form textarea{line-height:1.7}.form input,.panel input{min-height:90rpx;height:auto}.form button[type=primary],.panel button[type=primary]{margin-top:22rpx}.dates{gap:12rpx}.dates picker{flex:1;width:auto;min-width:0;font-size:25rpx;border:1rpx solid #e7ede8;background:#f6f8f6;border-radius:14rpx}.actions{gap:16rpx;justify-content:flex-end}.actions button,.action-row button{margin:0}.station{gap:18rpx}.station button{flex-shrink:0;margin:0}.photos image,.return-photos image{border:1rpx solid var(--line);border-radius:16rpx}.result,.source,.remaining,.approved{color:var(--brand)}.summary view,.capacity view{border:1rpx solid var(--line);border-radius:20rpx}.summary .number,.capacity .num{color:var(--ink);font-size:42rpx;font-weight:600}.capacity .num.available{color:var(--brand)}
