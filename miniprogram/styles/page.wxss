.page{min-height:100vh;box-sizing:border-box;padding:30rpx 30rpx calc(46rpx + env(safe-area-inset-bottom));background:var(--canvas);color:var(--ink)}
button{border:1rpx solid var(--line-strong)}button[type=primary]{border-color:var(--brand)}button[type=warn]{border-color:#f1c2c2}
.form,.panel,.card,.item,.record{background:#fff;border:1rpx solid var(--line);border-radius:var(--radius);box-shadow:none}
.form,.panel,.card{padding:30rpx}.item,.record{padding:28rpx;margin-bottom:20rpx}
.section-title{font-size:30rpx;color:var(--ink);font-weight:500;line-height:1.4}.name,.title{color:var(--ink)}
.muted,.desc,.comment,.meta,.hint{color:var(--muted);line-height:1.6}.desc{max-width:100%;word-break:break-all}
.row{gap:16rpx;align-items:flex-start}.row .name{flex:1;min-width:0;word-break:break-all}.row .status{flex-shrink:0}
.status{color:#002d9c;background:#d0e2ff;border-radius:100rpx;padding:4rpx 14rpx;font-size:22rpx;line-height:1.4}
.empty{padding:46rpx 24rpx;text-align:center;color:var(--subtle);background:#fff;border:1rpx dashed var(--line-strong);border-radius:6rpx;font-size:25rpx;line-height:1.6}
.notice,.progress,.eligibility{padding:22rpx 24rpx;line-height:1.6;border-radius:6rpx;font-size:24rpx;background:var(--brand-soft);color:#002d9c;border:1rpx solid #c6dcff}
.warning,.eligibility.blocked{background:#fff4e5;color:var(--warning);border-color:#e8c68a}.eligibility.allowed{background:var(--brand-soft);color:#002d9c}
.form textarea,.form input,.panel input,.picker{width:100%;background:#f2f4f8;border:1rpx solid var(--line-strong);border-radius:6rpx;font-size:27rpx}
.form textarea{padding:22rpx;line-height:1.6}.form input,.panel input{height:92rpx;min-height:92rpx;padding:0 22rpx;line-height:1.4}
.picker{display:flex;align-items:center;min-height:92rpx;padding:22rpx;line-height:1.4;word-break:break-all}
.form button[type=primary],.panel button[type=primary]{margin-top:24rpx}
.dates{gap:12rpx}.dates picker{flex:1;width:auto;min-width:0;font-size:25rpx;border:1rpx solid var(--line-strong);background:#f2f4f8;border-radius:6rpx;line-height:1.5}
.actions,.action-row{display:flex;gap:14rpx;flex-wrap:wrap;justify-content:flex-end}.actions button,.action-row button{margin:0;min-width:0}
.station{gap:18rpx}.station button{flex-shrink:0;margin:0}.photos image,.return-photos image{border:1rpx solid var(--line);border-radius:6rpx}
.result,.source,.remaining,.approved{color:var(--brand)}
.summary view,.capacity view{border:1rpx solid var(--line);border-radius:6rpx}.summary .number,.capacity .num{color:var(--ink);font-size:38rpx;font-weight:700}.capacity .num.available{color:var(--brand)}
.field-label{font-size:25rpx;font-weight:500;line-height:1.4;color:var(--muted)}
.mask,.rating-mask{background:#12161966}.sheet,.rating-dialog{border-radius:12rpx 12rpx 0 0;box-shadow:0 -8rpx 40rpx #00000014}
.sheet-head,.dialog-header{font-size:32rpx;font-weight:700;color:var(--ink)}
.sheet-head .close,.dialog-header .dialog-close{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;min-height:64rpx;max-height:64rpx;padding:0;margin:0;border:none;border-radius:50%;background:#f2f4f8;color:#697077;line-height:1}
.sheet-description{background:var(--brand-soft);border:1rpx solid #c6dcff;color:#002d9c;border-radius:6rpx}
.sheet-body .field,.sheet-body .textarea,.sheet-body .comment-input{border-color:var(--line-strong);border-radius:6rpx;background:#f2f4f8;color:var(--ink)}
.sheet-footer,.dialog-footer{border-top:1rpx solid var(--line);background:#fff}.sheet-footer button,.dialog-footer button{border-radius:6rpx;min-width:0}.sheet-footer button[type=primary],.dialog-footer button[type=primary]{background:var(--brand);border-color:var(--brand)}
